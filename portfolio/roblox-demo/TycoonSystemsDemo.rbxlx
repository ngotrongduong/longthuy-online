					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- DataService: player profiles with a SESSION LOCK, retries and autosave.
--
-- How the session lock works
--   * Load uses UpdateAsync. Inside the transform we look at profile.Lock.
--     If another server (JobId) holds a lock that is younger than SessionLockTimeout,
--     the transform returns nil (= cancel the write) and we retry with backoff.
--     Otherwise we write our own {JobId, Time} lock and take the profile.
--   * Every save is also an UpdateAsync that REFUSES to write if the lock in the store
--     is no longer ours (another server stole a stale lock): we never overwrite newer data.
--   * On leave / shutdown the final save clears the lock in the same write.
--
-- Studio without API access (or an unpublished place) cannot reach DataStores.
-- Then the service falls back to IN-MEMORY profiles. It says so in the output and in the
-- player attribute SaveMode = "Memory"; it never reports a save that did not happen.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

export type Profile = {
	Cash: number,
	Rebirths: number,
	Droppers: number,
	Receipts: { string }, -- PurchaseIds already granted (ProcessReceipt dedupe)
	Version: number,
	Lock: { JobId: string, Time: number }?,
}

local DataService = {}

local profiles: { [Player]: Profile } = {}
local store: GlobalDataStore? = nil
local mode = "Memory" -- "DataStore" | "Memory"
local jobId = (game.JobId ~= "" and game.JobId) or ("studio-" .. tostring(math.random(1e6, 9e6)))

local function newProfile(): Profile
	return {
		Cash = Config.StartCash,
		Rebirths = 0,
		Droppers = 1,
		Receipts = {},
		Version = 1,
		Lock = nil,
	}
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

-- Retries a DataStore call with exponential backoff. Returns ok, result.
local function withRetries<T>(label: string, attempts: number, fn: () -> T): (boolean, T?)
	local delay = 1
	for attempt = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[DataService] %s failed (attempt %d/%d): %s", label, attempt, attempts, tostring(result)))
		if attempt < attempts then
			task.wait(delay)
			delay = math.min(delay * 2, 16)
		end
	end
	return false, nil
end

-- Decide once whether DataStores are reachable.
local function initStore()
	local ok, result = pcall(function()
		local ds = DataStoreService:GetDataStore(Config.DataStoreName)
		ds:GetAsync("__probe") -- throws in Studio when API access is off / place unpublished
		return ds
	end)
	if ok then
		store = result
		mode = "DataStore"
	else
		store = nil
		mode = "Memory"
		warn(
			"[DataService] DataStores unavailable ("
				.. tostring(result)
				.. "). Using IN-MEMORY profiles: progress is NOT saved in this session."
		)
	end
end

function DataService.getMode(): string
	return mode
end

function DataService.get(player: Player): Profile?
	return profiles[player]
end

-- Loads (and locks) a profile. Returns nil if the player must be kicked.
function DataService.load(player: Player): Profile?
	if mode == "Memory" or not store then
		local p = newProfile()
		profiles[player] = p
		player:SetAttribute("SaveMode", "Memory")
		player:SetAttribute("SaveStatus", "Studio: DataStore offline, in-memory fallback")
		return p
	end

	local ds = store :: GlobalDataStore
	local key = keyFor(player)
	local loaded: Profile? = nil

	for attempt = 1, Config.LoadRetries do
		local lockedElsewhere = false
		local ok = withRetries("Load " .. key, 3, function()
			loaded = ds:UpdateAsync(key, function(old: Profile?)
				local p = old or newProfile()
				local lock = p.Lock
				if lock and lock.JobId ~= jobId and os.time() - lock.Time < Config.SessionLockTimeout then
					lockedElsewhere = true
					return nil -- cancel: another server still owns this session
				end
				lockedElsewhere = false
				p.Lock = { JobId = jobId, Time = os.time() }
				return p
			end)
		end)
		if not player.Parent then
			return nil -- left while loading
		end
		if ok and loaded and not lockedElsewhere then
			break
		end
		loaded = nil
		-- The other server usually releases the lock within a few seconds (player rejoining).
		task.wait(2 * attempt)
	end

	if not loaded then
		player:Kick("Your data is still open on another server. Please rejoin in a minute.")
		return nil
	end

	local p = loaded :: Profile
	-- Fill fields added in later versions
	local defaults = newProfile()
	for k, v in pairs(defaults) do
		if (p :: any)[k] == nil then
			(p :: any)[k] = v
		end
	end
	profiles[player] = p
	player:SetAttribute("SaveMode", "DataStore")
	player:SetAttribute("SaveStatus", "Loaded, session locked")
	return p
end

-- Writes the profile only if we still own the lock. release = true clears the lock.
function DataService.save(player: Player, release: boolean?): boolean
	local p = profiles[player]
	if not p then
		return false
	end
	if mode == "Memory" or not store then
		return false -- nothing was written; the caller must not report success
	end
	local ds = store :: GlobalDataStore
	local lostLock = false
	local ok = withRetries("Save " .. keyFor(player), 3, function()
		ds:UpdateAsync(keyFor(player), function(old: Profile?)
			if old and old.Lock and old.Lock.JobId ~= jobId then
				lostLock = true
				return nil -- someone else owns it now: never overwrite their newer data
			end
			local out = table.clone(p)
			out.Lock = if release then nil else { JobId = jobId, Time = os.time() }
			return out
		end)
	end)
	if lostLock then
		warn("[DataService] Lost the session lock for " .. player.Name .. "; save skipped.")
		return false
	end
	if ok and player.Parent then
		player:SetAttribute("SaveStatus", "Saved " .. os.date("!%H:%M:%S") .. " UTC")
	end
	return ok
end

function DataService.release(player: Player)
	if profiles[player] then
		DataService.save(player, true)
		profiles[player] = nil
	end
end

function DataService.start()
	initStore()

	-- Autosave loop (also refreshes the lock timestamp)
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(profiles) do
				task.spawn(DataService.save, player, false)
			end
		end
	end)

	Players.PlayerRemoving:Connect(DataService.release)

	game:BindToClose(function()
		if mode == "Memory" then
			return
		end
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				DataService.release(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + (if RunService:IsStudio() then 5 else 25)
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString>
					<string name="ScriptGuid">{D2385CD5-F356-4BF9-936D-1916EF5884F1}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">DataService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7d9f429a728148200af17e8900000c6f</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXE1ECD9CB4D9B4B68AF6D9D76C9F8F81F">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- ShopService: game passes and developer products, decided ONLY on the server.
--
--   * Pass ownership comes from MarketplaceService (UserOwnsGamePassAsync) at join and from
--     PromptGamePassPurchaseFinished after a purchase, then is re-checked on the server.
--     The client can only ASK for a prompt; it never says "I own this".
--   * Developer products go through ProcessReceipt. Each PurchaseId is granted once:
--     it is stored in the profile and the profile is saved BEFORE we return PurchaseGranted.
--     If anything fails we return NotProcessedYet and Roblox retries later.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local DataService = require(script.Parent.DataService)

local ShopService = {}

local owned: { [Player]: { [string]: boolean } } = {}
local passById: { [number]: any } = {}
local passByKey: { [string]: any } = {}
local productById: { [number]: any } = {}
local onChanged: ((Player) -> ())? = nil

for _, pass in ipairs(Config.Passes) do
	passByKey[pass.Key] = pass
	if pass.Id ~= 0 then
		passById[pass.Id] = pass
	end
end
for _, product in ipairs(Config.Products) do
	if product.Id ~= 0 then
		productById[product.Id] = product
	end
end

local function setOwned(player: Player, key: string, value: boolean)
	owned[player] = owned[player] or {}
	if owned[player][key] == value then
		return
	end
	owned[player][key] = value
	player:SetAttribute("Pass_" .. key, value) -- replicated, for display only
	if onChanged then
		onChanged(player)
	end
end

local function checkOwnership(player: Player, pass: any): boolean
	if pass.Id == 0 then
		return false -- pass not created yet (placeholder id)
	end
	for _ = 1, 3 do
		local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
		if ok then
			return result
		end
		task.wait(1)
	end
	return false
end

function ShopService.owns(player: Player, key: string): boolean
	return owned[player] ~= nil and owned[player][key] == true
end

-- Called by the remote handler when the player taps a pass card.
function ShopService.promptPass(player: Player, key: string)
	local pass = passByKey[key]
	if not pass or ShopService.owns(player, key) then
		return
	end
	if pass.Id == 0 then
		warn("[ShopService] Pass '" .. key .. "' has no id yet; set it in Config.Passes.")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

-- DEMO ONLY. Used by AutoDemo_ForRecording to show the owned state without a real Robux
-- purchase (Studio cannot sell passes). It goes through the same setOwned path as a real
-- purchase. Nothing else calls it.
function ShopService.grantForDemo(player: Player, key: string)
	if passByKey[key] then
		setOwned(player, key, true)
	end
end

function ShopService.playerAdded(player: Player)
	owned[player] = {}
	for _, pass in ipairs(Config.Passes) do
		player:SetAttribute("Pass_" .. pass.Key, false)
		task.spawn(function()
			if checkOwnership(player, pass) and player.Parent then
				setOwned(player, pass.Key, true)
			end
		end)
	end
end

local function processReceipt(receipt): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local product = productById[receipt.ProductId]
	if not player or not product then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = DataService.get(player)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local id = tostring(receipt.PurchaseId)
	if table.find(profile.Receipts, id) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already granted earlier
	end

	-- Grant, remember the receipt, and save before confirming.
	profile.Cash += product.Cash
	table.insert(profile.Receipts, id)
	while #profile.Receipts > Config.ReceiptHistory do
		table.remove(profile.Receipts, 1)
	end
	if DataService.getMode() == "DataStore" and not DataService.save(player) then
		-- Roll back and let Roblox retry: never confirm a grant we could not store.
		profile.Cash -= product.Cash
		table.remove(profile.Receipts, table.find(profile.Receipts, id) :: number)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if onChanged then
		onChanged(player)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.start(changed: (Player) -> ())
	onChanged = changed

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local pass = passById[passId]
		if purchased and pass then
			-- This event fires on the server from Roblox itself, so it can be trusted.
			setOwned(player, pass.Key, true)
		end
	end)

	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
	end)
end

return ShopService
]]></ProtectedString>
					<string name="ScriptGuid">{C0EE38A0-B6DD-43C4-BF65-7E86D4E3F7D8}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ShopService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7d9f429a728148200af17e8900000c71</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX272A0147E6C94C919EDFE372D7777414">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- TycoonService: droppers, conveyor, collector, upgrades and rebirth. Server-authoritative:
-- the client sends requests ("BuyDropper", "Rebirth"); every check and every change of
-- money happens here, and the result is replicated through player attributes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local FxEvent = Remotes:WaitForChild("Fx") :: RemoteEvent
local FxFast = Remotes:WaitForChild("FxFast") :: UnreliableRemoteEvent

local plot = workspace:WaitForChild("Plot")
local slots = plot:WaitForChild("DropperSlots")
local belt = plot:WaitForChild("Conveyor"):WaitForChild("Belt") :: BasePart
local collector = plot:WaitForChild("Collector")
local sensor = collector:WaitForChild("Sensor") :: BasePart
local collectPad = plot:WaitForChild("CollectPad") :: BasePart
local buyPad = plot:WaitForChild("BuyDropperPad") :: BasePart
local rebirthPad = plot:WaitForChild("RebirthPad") :: BasePart
local template = ServerStorage:WaitForChild("DropperTemplate") :: Model

local BELT_SPEED = 13

local TycoonService = {}

local owner: Player? = nil
local bank = 0 -- cash waiting in the collector
local busy = false -- a rebirth is playing
local droppers: { Model } = {}
local nextDrop: { number } = {}
local liveDrops: { [BasePart]: boolean } = {}
local liveCount = 0
local dropFolder = Instance.new("Folder")
dropFolder.Name = "Drops"
dropFolder.Parent = plot

-- Helpers ------------------------------------------------------------------

local function multiplier(player: Player): number
	local p = DataService.get(player)
	local m = Config.RebirthMultiplier(if p then p.Rebirths else 0)
	for key, effect in pairs(Config.PassEffects) do
		if effect.CashMultiplier and ShopService.owns(player, key) then
			m *= effect.CashMultiplier
		end
	end
	return m
end

local function dropInterval(player: Player): number
	local scale = 1
	for key, effect in pairs(Config.PassEffects) do
		if effect.DropIntervalScale and ShopService.owns(player, key) then
			scale *= effect.DropIntervalScale
		end
	end
	return Config.DropInterval * scale
end

-- Pushes the authoritative state to replicated attributes (display only).
local function publish(player: Player)
	local p = DataService.get(player)
	if not p then
		return
	end
	player:SetAttribute("Cash", p.Cash)
	player:SetAttribute("Bank", bank)
	player:SetAttribute("Rebirths", p.Rebirths)
	player:SetAttribute("Droppers", p.Droppers)
	player:SetAttribute("Multiplier", multiplier(player))
	player:SetAttribute("RebirthMultiplier", Config.RebirthMultiplier(p.Rebirths))
	player:SetAttribute("DropperCost", if p.Droppers < Config.MaxDroppers then Config.DropperCost(p.Droppers) else -1)
	player:SetAttribute("RebirthCost", Config.RebirthCost(p.Rebirths))

	local screen = collector:FindFirstChild("Screen")
	local label = screen and screen:FindFirstChild("Value", true)
	if label and label:IsA("TextLabel") then
		label.Text = if ShopService.owns(player, "AutoCollect") then "AUTO" else Format.cash(bank)
	end
	local collectLabel = collectPad:FindFirstChild("Cost", true)
	if collectLabel and collectLabel:IsA("TextLabel") then
		collectLabel.Text = if ShopService.owns(player, "AutoCollect") then "auto: on" else "step here"
	end
	local buyLabel = buyPad:FindFirstChild("Cost", true)
	if buyLabel and buyLabel:IsA("TextLabel") then
		buyLabel.Text = if p.Droppers < Config.MaxDroppers then Format.cash(Config.DropperCost(p.Droppers)) else "MAX"
	end
	local rebirthLabel = rebirthPad:FindFirstChild("Cost", true)
	if rebirthLabel and rebirthLabel:IsA("TextLabel") then
		rebirthLabel.Text = Format.cash(Config.RebirthCost(p.Rebirths))
	end
end

local function slotFor(i: number): BasePart
	return slots:FindFirstChild("Slot" .. i) :: BasePart
end

local function buildDroppers(count: number, announceIndex: number?)
	for i = #droppers + 1, count do
		local slot = slotFor(i)
		local m = template:Clone()
		m.Name = "Dropper" .. i
		m:PivotTo(slot.CFrame)
		m.Parent = plot
		droppers[i] = m
		nextDrop[i] = os.clock() + 0.6 + i * 0.13
		if announceIndex == i then
			FxEvent:FireAllClients("DropperBuilt", m)
		end
	end
	for i = #droppers, count + 1, -1 do
		droppers[i]:Destroy()
		droppers[i] = nil
		nextDrop[i] = nil
	end
end

local function clearDrops()
	for part in pairs(liveDrops) do
		part:Destroy()
	end
	table.clear(liveDrops)
	liveCount = 0
end

local function spawnDrop(dropper: Model, golden: boolean)
	if liveCount >= Config.MaxLiveDrops then
		return
	end
	local spout = dropper:FindFirstChild("Spout", true) :: Attachment
	local part = Instance.new("Part")
	part.Name = "Drop"
	part.Size = Vector3.new(1.15, 1.15, 1.15)
	part.Material = Enum.Material.SmoothPlastic
	part.Color = if golden then Color3.fromRGB(255, 200, 70) else Color3.fromRGB(70, 230, 170)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = CFrame.new(spout.WorldPosition) * CFrame.Angles(0, math.random() * math.pi, 0)
	part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.6, 0.1)
	part:SetAttribute("Golden", golden)
	part.Parent = dropFolder
	part:SetNetworkOwner(nil) -- the server simulates every drop
	liveDrops[part] = true
	liveCount += 1
	-- Safety: a drop that never reaches the collector is removed
	task.delay(20, function()
		if liveDrops[part] then
			liveDrops[part] = nil
			liveCount -= 1
			part:Destroy()
		end
	end)
end

local function credit(player: Player, amount: number)
	local p = DataService.get(player)
	if not p then
		return
	end
	if ShopService.owns(player, "AutoCollect") then
		p.Cash += amount
	else
		bank += amount
	end
	publish(player)
end

local function onSensorTouched(hit: BasePart)
	if not liveDrops[hit] or not owner then
		return
	end
	liveDrops[hit] = nil
	liveCount -= 1
	local value = math.floor(Config.DropValue * multiplier(owner) + 0.5)
	local pos = hit.Position
	local golden = hit:GetAttribute("Golden") == true
	hit:Destroy()
	credit(owner, value)
	FxFast:FireAllClients("Collect", value, pos, golden)
end

-- Public API (used by remotes and by AutoDemo_ForRecording) -----------------

function TycoonService.getOwner(): Player?
	return owner
end

function TycoonService.claimBank(player: Player): boolean
	local p = DataService.get(player)
	if player ~= owner or not p or bank <= 0 then
		return false
	end
	local amount = bank
	bank = 0
	p.Cash += amount
	publish(player)
	FxEvent:FireAllClients("BankClaimed", amount)
	return true
end

function TycoonService.buyDropper(player: Player): boolean
	local p = DataService.get(player)
	if player ~= owner or not p or busy then
		return false
	end
	if p.Droppers >= Config.MaxDroppers then
		return false
	end
	local cost = Config.DropperCost(p.Droppers)
	if p.Cash < cost then
		FxEvent:FireClient(player, "Denied", "Need " .. Format.cash(cost - p.Cash) .. " more")
		return false
	end
	p.Cash -= cost
	p.Droppers += 1
	buildDroppers(p.Droppers, p.Droppers)
	publish(player)
	FxEvent:FireClient(player, "Spent", cost)
	return true
end

function TycoonService.rebirth(player: Player): boolean
	local p = DataService.get(player)
	if player ~= owner or not p or busy then
		return false
	end
	local cost = Config.RebirthCost(p.Rebirths)
	if p.Cash < cost then
		FxEvent:FireClient(player, "Denied", "Rebirth needs " .. Format.cash(cost))
		return false
	end
	busy = true
	local from = Config.RebirthMultiplier(p.Rebirths)
	local to = Config.RebirthMultiplier(p.Rebirths + 1)
	FxEvent:FireAllClients("RebirthStart", from, to)
	task.wait(0.9) -- let the clients play the build-up; the reset lands on the flash
	if not player.Parent or DataService.get(player) ~= p or p.Cash < cost then
		busy = false
		return false
	end
	p.Rebirths += 1
	p.Cash = Config.StartCash
	p.Droppers = 1
	bank = 0
	clearDrops()
	buildDroppers(1)
	publish(player)
	FxEvent:FireAllClients("RebirthDone", p.Rebirths, to)
	busy = false
	return true
end

function TycoonService.refresh(player: Player)
	if player == owner then
		-- Auto Collect just turned on: pay out what is waiting in the collector
		local p = DataService.get(player)
		if p and bank > 0 and ShopService.owns(player, "AutoCollect") then
			local amount = bank
			bank = 0
			p.Cash += amount
			FxEvent:FireAllClients("BankClaimed", amount)
		end
		publish(player)
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		if head and ShopService.owns(player, "VIP") and not head:FindFirstChild("VipTag") then
			local tag = Instance.new("BillboardGui")
			tag.Name = "VipTag"
			tag.Size = UDim2.fromOffset(90, 30)
			tag.StudsOffset = Vector3.new(0, 2.4, 0)
			tag.AlwaysOnTop = true
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundTransparency = 1
			t.Text = "VIP"
			t.TextScaled = true
			t.Font = Enum.Font.GothamBlack
			t.TextColor3 = Color3.fromRGB(255, 210, 90)
			t.Parent = tag
			tag.Parent = head
		end
	end
end

function TycoonService.claimPlot(player: Player)
	if owner then
		return -- this demo place has one plot
	end
	owner = player
	local p = DataService.get(player)
	buildDroppers(if p then p.Droppers else 1)
	publish(player)
end

function TycoonService.releasePlot(player: Player)
	if owner ~= player then
		return
	end
	owner = nil
	bank = 0
	clearDrops()
	buildDroppers(0)
end

function TycoonService.start()
	belt.AssemblyLinearVelocity = Vector3.new(BELT_SPEED, 0, 0)
	sensor.Touched:Connect(onSensorTouched)

	local padDebounce: { [Player]: number } = {}
	local function padHandler(fn: (Player) -> boolean)
		return function(hit: BasePart)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if not player then
				return
			end
			local now = os.clock()
			if (padDebounce[player] or 0) > now then
				return
			end
			padDebounce[player] = now + 0.8
			fn(player)
		end
	end
	collectPad.Touched:Connect(padHandler(TycoonService.claimBank))
	buyPad.Touched:Connect(padHandler(TycoonService.buyDropper))
	rebirthPad.Touched:Connect(padHandler(TycoonService.rebirth))

	-- One scheduler for all droppers
	RunService.Heartbeat:Connect(function()
		local player = owner
		if not player or busy then
			return
		end
		local now = os.clock()
		local interval = dropInterval(player)
		local golden = ShopService.owns(player, "DoubleCash")
		for i, dropper in ipairs(droppers) do
			if now >= nextDrop[i] then
				nextDrop[i] = now + interval
				spawnDrop(dropper, golden)
			end
		end
	end)
end

return TycoonService
]]></ProtectedString>
					<string name="ScriptGuid">{D69551A6-ACC8-44C2-8C50-1C8F7DB7B825}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">TycoonService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7d9f429a728148200af17e8900000c73</UniqueId>
				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX4E25034C3D7D458A950D16B8E9DD1587">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Main: boots the services and validates every client request.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Services = script.Parent:WaitForChild("Services")
local DataService = require(Services.DataService)
local ShopService = require(Services.ShopService)
local TycoonService = require(Services.TycoonService)

local Action = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Action") :: RemoteEvent

DataService.start()
ShopService.start(function(player)
	TycoonService.refresh(player)
end)
TycoonService.start()

local function onPlayerAdded(player: Player)
	local profile = DataService.load(player)
	if not profile or not player.Parent then
		return
	end
	ShopService.playerAdded(player)
	TycoonService.claimPlot(player)
	local function onCharacter(character: Model)
		-- Plain outfit (the place does not load avatars: StarterPlayer.LoadCharacterAppearance = false)
		local colors = character:FindFirstChildOfClass("BodyColors") or Instance.new("BodyColors")
		local skin, shirt, pants = Color3.fromRGB(234, 184, 146), Color3.fromRGB(40, 170, 140), Color3.fromRGB(44, 48, 62)
		colors.HeadColor3, colors.LeftArmColor3, colors.RightArmColor3 = skin, skin, skin
		colors.TorsoColor3, colors.LeftLegColor3, colors.RightLegColor3 = shirt, pants, pants
		colors.Parent = character
		task.wait(0.5)
		TycoonService.refresh(player)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player:SetAttribute("Ready", true)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerRemoving:Connect(TycoonService.releasePlot)

-- Client requests: names are whitelisted, arguments type-checked, rate limited.
local lastRequest: { [Player]: number } = {}
local handlers: { [string]: (Player, any) -> () } = {
	BuyDropper = function(player)
		TycoonService.buyDropper(player)
	end,
	Rebirth = function(player)
		TycoonService.rebirth(player)
	end,
	Collect = function(player)
		TycoonService.claimBank(player)
	end,
	PromptPass = function(player, key)
		if typeof(key) == "string" and #key < 32 then
			ShopService.promptPass(player, key)
		end
	end,
}

Action.OnServerEvent:Connect(function(player, name, arg)
	if typeof(name) ~= "string" or not handlers[name] then
		return
	end
	local now = os.clock()
	if (lastRequest[player] or 0) + 0.2 > now then
		return
	end
	lastRequest[player] = now
	handlers[name](player, arg)
end)

Players.PlayerRemoving:Connect(function(player)
	lastRequest[player] = nil
end)
]]></ProtectedString>
