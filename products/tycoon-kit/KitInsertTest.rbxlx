        <Item class="Script" referent="14">
          <Properties>
            <string name="Name">Main</string>
            <bool name="Disabled">true</bool>
            <string name="Source"><![CDATA[--!strict
-- Main: starts the kit's services, handles players joining and leaving, and checks
-- every request a client sends.
-- Installed at: ServerScriptService.TycoonKit.Main
--
-- This Script is DISABLED inside the TycoonSystemsKit model so it does not run while the
-- model sits in Workspace. The Installer moves it to ServerScriptService and enables it.
-- If you install by hand, set Main.Enabled = true after moving the folder.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("TycoonKit")
local Config = require(Shared:WaitForChild("Config"))
local Action = Shared:WaitForChild("Remotes"):WaitForChild("Action") :: RemoteEvent

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)
local TycoonService = require(script.Parent.TycoonService)

DataService.start()
ShopService.start(TycoonService.refresh)
TycoonService.start()

---------------------------------------------------------------------------------------
-- Players
---------------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	local profile = DataService.load(player)
	if not profile or not player.Parent then
		return -- kicked (data locked elsewhere) or left while loading
	end
	ShopService.playerAdded(player)
	TycoonService.claimPlot(player)
	player.CharacterAdded:Connect(function(character)
		TycoonService.onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(TycoonService.onCharacter, player, player.Character)
	end
	player:SetAttribute("TycoonReady", true)
end

-- Order matters on leave: free the plot first (it pays the collector's bank into the
-- profile), then save and unlock the profile.
local function onPlayerRemoving(player: Player)
	TycoonService.releasePlot(player)
	ShopService.playerRemoving(player)
	DataService.release(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player) -- players who joined before this script ran
end

---------------------------------------------------------------------------------------
-- Client requests
--   who:        the request must come from a loaded player (TycoonService also checks
--               that the player owns the plot it acts on)
--   what:       only whitelisted names; arguments are type- and length-checked
--   how often:  one request per Config.RequestInterval per player, extras are dropped
--   can afford: TycoonService / ShopService check the price on the server
---------------------------------------------------------------------------------------

local lastRequest: { [Player]: number } = {}

local function shortString(value: any): boolean
	return typeof(value) == "string" and #value > 0 and #value <= 32
end

local handlers: { [string]: (Player, any) -> () } = {
	BuyDropper = function(player)
		TycoonService.buyDropper(player)
	end,
	Rebirth = function(player)
		TycoonService.rebirth(player)
	end,
	Collect = function(player)
		TycoonService.claimBank(player)
	end,
	PromptPass = function(player, key)
		if shortString(key) then
			ShopService.promptPass(player, key)
		end
	end,
	PromptProduct = function(player, key)
		if shortString(key) then
			ShopService.promptProduct(player, key)
		end
	end,
}

Action.OnServerEvent:Connect(function(player: Player, name: any, arg: any)
	if typeof(name) ~= "string" or not handlers[name] then
		return
	end
	if not DataService.get(player) then
		return -- profile not loaded yet
	end
	local now = os.clock()
	if (lastRequest[player] or 0) + Config.RequestInterval > now then
		return
	end
	lastRequest[player] = now
	handlers[name](player, arg)
end)

Players.PlayerRemoving:Connect(function(player)
	lastRequest[player] = nil
end)

print(string.format("[TycoonKit] Running. Save mode: %s.", DataService.getMode()))
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- DataService: player profiles saved with DataStoreService, protected by a SESSION LOCK.
-- Installed at: ServerScriptService.TycoonKit.DataService
--
-- Why a session lock: when a player hops servers quickly, the old server may still be
-- saving while the new one loads. Without a lock the old save can overwrite newer data.
--
-- How it works
--   * load(): UpdateAsync on the player's key. Inside the transform we read profile.Lock.
--     If ANOTHER server (JobId) holds a lock younger than the timeout, we cancel the write
--     (return nil) and retry with a growing wait. Otherwise we write our own
--     { JobId, Time } lock and take the profile.
--   * save(): also UpdateAsync, and it REFUSES to write if the lock in the store is no
--     longer ours. We never overwrite data another server now owns.
--   * Autosave every Config.AutosaveSeconds (this also refreshes the lock time).
--   * release(): the final save on leave or shutdown clears the lock in the same write.
--   * game:BindToClose waits (bounded) for the final saves when a server shuts down.
--   * Every DataStore call is retried with exponential backoff (1, 2, 4, 8 s ...).
--
-- Studio: without "Enable Studio Access to API Services" (or in an unpublished place)
-- DataStores cannot be reached. With Config.StudioMemoryFallback the kit then uses
-- IN-MEMORY profiles, prints one clear warning and sets the player attribute
-- SaveMode = "Memory". It never reports a save that did not happen.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("TycoonKit"):WaitForChild("Config"))

export type Profile = {
	Cash: number,
	Rebirths: number,
	Droppers: number,
	Receipts: { string }, -- developer-product PurchaseIds already granted
	Version: number,
	Lock: { JobId: string, Time: number }?,
}

local DataService = {}

local profiles: { [Player]: Profile } = {}
local store: GlobalDataStore? = nil
local mode = "DataStore" -- "DataStore" | "Memory"
local jobId = if game.JobId ~= "" then game.JobId else ("studio-" .. tostring(math.random(1e6, 9e6)))
local lockTimeout = math.max(Config.SessionLockTimeout, Config.AutosaveSeconds * 3)

local function newProfile(): Profile
	return {
		Cash = Config.StartCash,
		Rebirths = 0,
		Droppers = 1,
		Receipts = {},
		Version = 1,
		Lock = nil,
	}
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

-- Repairs a loaded profile: fills fields added in later versions and fixes bad types,
-- so a hand-edited or old entry can never break the game.
local function sanitize(raw: any): Profile
	local p = newProfile()
	if type(raw) ~= "table" then
		return p
	end
	if type(raw.Cash) == "number" and raw.Cash == raw.Cash then
		p.Cash = math.max(0, raw.Cash)
	end
	if type(raw.Rebirths) == "number" then
		p.Rebirths = math.max(0, math.floor(raw.Rebirths))
	end
	if type(raw.Droppers) == "number" then
		p.Droppers = math.clamp(math.floor(raw.Droppers), 1, Config.MaxDroppers)
	end
	if type(raw.Receipts) == "table" then
		for _, id in ipairs(raw.Receipts) do
			if type(id) == "string" then
				table.insert(p.Receipts, id)
			end
		end
	end
	local lock = raw.Lock
	if type(lock) == "table" and type(lock.JobId) == "string" and type(lock.Time) == "number" then
		p.Lock = { JobId = lock.JobId, Time = lock.Time }
	end
	return p
end

-- Runs fn with retries and exponential backoff. Returns ok, result.
local function withRetries<T>(label: string, attempts: number, fn: () -> T): (boolean, T?)
	local delay = 1
	for attempt = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[TycoonKit] %s failed (try %d/%d): %s", label, attempt, attempts, tostring(result)))
		if attempt < attempts then
			task.wait(delay)
			delay = math.min(delay * 2, 16)
		end
	end
	return false, nil
end

-- Decides once whether DataStores are reachable.
local function initStore()
	local ok, result = pcall(function()
		local ds = DataStoreService:GetDataStore(Config.DataStoreName)
		if RunService:IsStudio() then
			ds:GetAsync("__probe") -- throws in Studio when API access is off
		end
		return ds
	end)
	if ok then
		store = result
		mode = "DataStore"
		return
	end
	if RunService:IsStudio() and Config.StudioMemoryFallback then
		store = nil
		mode = "Memory"
		warn(
			"[TycoonKit] DataStores are not available in this Studio session ("
				.. tostring(result)
				.. "). Using IN-MEMORY profiles: progress is NOT saved. To test saving: publish the place, then "
				.. "Game Settings > Security > Enable Studio Access to API Services."
		)
	else
		-- Live server: GetDataStore practically never fails; keep DataStore mode so every
		-- load is retried and a player is asked to rejoin rather than playing unsaved.
		warn("[TycoonKit] GetDataStore failed: " .. tostring(result))
		store = nil
		mode = "DataStore"
	end
end

function DataService.getMode(): string
	return mode
end

function DataService.get(player: Player): Profile?
	return profiles[player]
end

-- Loads and locks the profile. Returns nil when the player was kicked or left.
function DataService.load(player: Player): Profile?
	if mode == "Memory" then
		local p = newProfile()
		profiles[player] = p
		player:SetAttribute("SaveMode", "Memory")
		player:SetAttribute("SaveStatus", "Studio test: not saved")
		return p
	end

	if not store then
		pcall(function()
			store = DataStoreService:GetDataStore(Config.DataStoreName)
		end)
	end
	local ds = store
	local key = keyFor(player)
	local loaded: Profile? = nil

	if ds then
		for attempt = 1, Config.LoadRetries do
			local lockedElsewhere = false
			local ok, result = withRetries("Load " .. key, 3, function()
				return ds:UpdateAsync(key, function(old: any)
					local p = sanitize(old)
					local lock = p.Lock
					if lock and lock.JobId ~= jobId and os.time() - (lock.Time or 0) < lockTimeout then
						lockedElsewhere = true
						return nil -- cancel: another server still owns this session
					end
					lockedElsewhere = false
					p.Lock = { JobId = jobId, Time = os.time() }
					return p
				end)
			end)
			if not player.Parent then
				return nil -- left while loading (the lock, if taken, times out on its own)
			end
			if ok and result and not lockedElsewhere then
				loaded = sanitize(result)
				break
			end
			-- Usually the other server releases the lock within seconds (a quick rejoin).
			task.wait(2 * attempt)
		end
	end

	if not loaded then
		player:Kick("Your saved data could not be opened right now. Please rejoin in a minute.")
		return nil
	end

	profiles[player] = loaded
	player:SetAttribute("SaveMode", "DataStore")
	player:SetAttribute("SaveStatus", "Loaded")
	return loaded
end

-- Writes profile p of player, only while we still own the lock. release = true clears
-- the lock. Returns true only when the data really reached the DataStore.
local function writeProfile(player: Player, p: Profile, release: boolean?): boolean
	if mode == "Memory" or not store then
		return false
	end
	local ds = store :: GlobalDataStore
	local lostLock = false
	local ok = withRetries("Save " .. keyFor(player), 3, function()
		ds:UpdateAsync(keyFor(player), function(old: any)
			if type(old) == "table" and type(old.Lock) == "table" and old.Lock.JobId ~= jobId then
				lostLock = true
				return nil -- another server owns it now: never overwrite its newer data
			end
			lostLock = false
			local out = table.clone(p)
			out.Lock = if release then nil else { JobId = jobId, Time = os.time() }
			return out
		end)
	end)
	if lostLock then
		warn("[TycoonKit] Session lock for " .. player.Name .. " is held by another server; save skipped.")
		return false
	end
	if ok and player.Parent then
		player:SetAttribute("SaveStatus", "Saved " .. os.date("!%H:%M") .. " UTC")
	end
	return ok
end

-- Saves the loaded profile of a player who is still in the game (autosave, purchases).
function DataService.save(player: Player): boolean
	local p = profiles[player]
	if not p then
		return false
	end
	return writeProfile(player, p, false)
end

-- Final save + unlock, then forget the profile. Called on PlayerRemoving and on
-- shutdown; the profile is taken out first so the two can never both save it.
function DataService.release(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	profiles[player] = nil
	writeProfile(player, p, true)
end

function DataService.start()
	initStore()

	-- Autosave loop (also refreshes the lock time so other servers see it is alive)
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(profiles) do
				task.spawn(DataService.save, player)
			end
		end
	end)

	-- Server shutdown: save everyone, wait at most ~25 s (Roblox allows 30).
	game:BindToClose(function()
		if mode == "Memory" then
			return
		end
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				DataService.release(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + (if RunService:IsStudio() then 5 else 25)
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- ShopService: game passes and developer products, decided ONLY on the server.
-- Installed at: ServerScriptService.TycoonKit.ShopService
--
--   * Game passes: ownership comes from MarketplaceService.UserOwnsGamePassAsync when the
--     player joins, and from PromptGamePassPurchaseFinished (fired on the server by
--     Roblox) after a purchase in this session. The client can only ASK for a prompt; it
--     never tells the server "I own this". Effects are applied by TycoonService.
--   * Developer products: MarketplaceService.ProcessReceipt. Each PurchaseId is granted
--     once: it is stored in the profile and the profile is SAVED before we answer
--     PurchaseGranted. If anything fails we answer NotProcessedYet and Roblox retries.
--   * Pass ownership is mirrored to player attributes "Pass_<Key>" for the HUD only.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("TycoonKit")
local Config = require(Shared:WaitForChild("Config"))
local DataService = require(script.Parent.DataService)

local Fx = Shared:WaitForChild("Remotes"):WaitForChild("Fx") :: RemoteEvent

local ShopService = {}

local owned: { [Player]: { [string]: boolean } } = {}
local onChanged: ((Player) -> ())? = nil

-- Lookups read Config every time (the lists are short), so ids set at run time count.
local function find(list: { any }, field: string, value: any): any
	if value == 0 or value == nil then
		return nil -- 0 is the "not created yet" placeholder, never a real id
	end
	for _, entry in ipairs(list) do
		if entry[field] == value then
			return entry
		end
	end
	return nil
end
local function passByKey(key: string): any
	return find(Config.Passes, "Key", key)
end
local function passById(id: number): any
	return find(Config.Passes, "Id", id)
end
local function productByKey(key: string): any
	return find(Config.Products, "Key", key)
end
local function productById(id: number): any
	return find(Config.Products, "Id", id)
end

---------------------------------------------------------------------------------------
-- Custom product rewards
-- A product with an entry here uses it instead of the default Grant.Cash reward.
-- The function changes the profile and returns an "undo" function used if the save
-- fails (so a purchase is never half granted). Example:
--
--   ProductRewards.SkipRebirth = function(player, profile)
--       profile.Rebirths += 1
--       return function() profile.Rebirths -= 1 end
--   end
---------------------------------------------------------------------------------------
local ProductRewards: { [string]: (Player, DataService.Profile) -> () -> () } = {}

local function defaultReward(product: any): (Player, DataService.Profile) -> () -> ()
	return function(_player, profile)
		local cash = (product.Grant and product.Grant.Cash) or 0
		profile.Cash += cash
		return function()
			profile.Cash -= cash
		end
	end
end

local function setOwned(player: Player, key: string, value: boolean)
	local list = owned[player]
	if not list or list[key] == value then
		return
	end
	list[key] = value
	player:SetAttribute("Pass_" .. key, value)
	if onChanged then
		onChanged(player)
	end
end

local function checkOwnership(player: Player, pass: any): boolean
	if pass.Id == 0 then
		return false -- placeholder id: not created yet
	end
	for attempt = 1, 3 do
		local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
		if ok then
			return result == true
		end
		if attempt == 3 then
			warn("[TycoonKit] Could not check pass " .. pass.Key .. " for " .. player.Name .. ": " .. tostring(result))
		end
		task.wait(attempt)
	end
	return false
end

-- True when the player owns the pass with this Key.
function ShopService.owns(player: Player, key: string): boolean
	local list = owned[player]
	return list ~= nil and list[key] == true
end

-- True when any owned pass has this effect; returns the combined value for numbers
-- (multiplied) or true for flags. Used by TycoonService.
function ShopService.effect(player: Player, name: string): any
	local result: any = nil
	for _, pass in ipairs(Config.Passes) do
		local value = pass.Effects and pass.Effects[name]
		if value ~= nil and ShopService.owns(player, pass.Key) then
			if type(value) == "number" then
				result = (result or 1) * value
			else
				result = value
			end
		end
	end
	return result
end

-- Remote: the player tapped a pass card.
function ShopService.promptPass(player: Player, key: string)
	local pass = passByKey(key)
	if not pass or ShopService.owns(player, key) then
		return
	end
	if pass.Id == 0 then
		warn("[TycoonKit] Pass '" .. key .. "' has Id = 0. Put your pass id in Config.Passes.")
		Fx:FireClient(player, "Denied", "Not for sale yet")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

-- Remote: the player tapped a product card.
function ShopService.promptProduct(player: Player, key: string)
	local product = productByKey(key)
	if not product then
		return
	end
	if product.Id == 0 then
		warn("[TycoonKit] Product '" .. key .. "' has Id = 0. Put your product id in Config.Products.")
		Fx:FireClient(player, "Denied", "Not for sale yet")
		return
	end
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

function ShopService.playerAdded(player: Player)
	owned[player] = {}
	-- Studio only: Config.StudioOwnsAllPasses lets you try every pass effect for free.
	local studioAll = Config.StudioOwnsAllPasses == true and RunService:IsStudio()
	for _, pass in ipairs(Config.Passes) do
		player:SetAttribute("Pass_" .. pass.Key, false)
		if studioAll then
			setOwned(player, pass.Key, true)
		else
			task.spawn(function()
				if checkOwnership(player, pass) and player.Parent then
					setOwned(player, pass.Key, true)
				end
			end)
		end
	end
end

function ShopService.playerRemoving(player: Player)
	owned[player] = nil
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local product = productById(receipt.ProductId)
	if not product then
		warn("[TycoonKit] Receipt for unknown product id " .. tostring(receipt.ProductId) .. " (add it to Config.Products).")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- granted next time they join
	end
	local profile = DataService.get(player)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- still loading
	end

	local id = tostring(receipt.PurchaseId)
	if table.find(profile.Receipts, id) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- granted before: do not grant twice
	end

	-- Grant, remember the receipt, and SAVE before confirming.
	local reward = ProductRewards[product.Key] or defaultReward(product)
	local ok, undo = pcall(reward, player, profile)
	if not ok then
		warn("[TycoonKit] Reward for " .. product.Key .. " failed: " .. tostring(undo))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(profile.Receipts, id)
	while #profile.Receipts > Config.ReceiptHistory do
		table.remove(profile.Receipts, 1)
	end

	local saved = DataService.save(player)
	local studioTest = DataService.getMode() == "Memory" and RunService:IsStudio()
	if not saved and not studioTest then
		-- Roll back and let Roblox retry later: never confirm a grant we could not store.
		undo()
		local index = table.find(profile.Receipts, id)
		if index then
			table.remove(profile.Receipts, index)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	Fx:FireClient(player, "ProductGranted", product.Name)
	if onChanged then
		onChanged(player)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- changed(player) is called whenever something that affects the plot changed.
function ShopService.start(changed: (Player) -> ())
	onChanged = changed

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local pass = passById(passId)
		if purchased and pass and player.Parent then
			-- Fired on the server by Roblox itself, so it can be trusted.
			setOwned(player, pass.Key, true)
		end
	end)

	-- Only ONE script in a game may set ProcessReceipt. If your game already has one,
	-- call this kit's handler from it instead (see README).
	MarketplaceService.ProcessReceipt = processReceipt
end

-- Exposed for games that already have their own ProcessReceipt (see README).
ShopService.processReceipt = processReceipt
ShopService.ProductRewards = ProductRewards

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">TycoonService</string>
            <string name="Source"><![CDATA[--!strict
-- TycoonService: plots, droppers, conveyor, collector, dropper upgrade and rebirth.
-- Installed at: ServerScriptService.TycoonKit.TycoonService
--
-- Server-authoritative: clients send REQUESTS ("BuyDropper", "Rebirth", "Collect") or
-- step on floor pads; every check and every change of money happens here. The results
-- are replicated through player attributes (Cash, Bank, Rebirths, ...) that the HUD
-- only displays.
--
-- Plots: every Model in Workspace with the CollectionService tag "TycoonPlot" is a plot.
-- Duplicate the example Plot (it keeps its tag) to have one plot per player in a server.
-- A player gets the first free plot when they join and loses it when they leave.
--
-- A plot needs these children (names matter, positions are free):
--   Conveyor.Belt         anchored part; drops ride on it toward the collector
--   Collector.Sensor      non-colliding part; a drop touching it is sold
--   Collector.Screen      optional; SurfaceGui with a TextLabel "Value" shows the bank
--   CollectPad, BuyDropperPad, RebirthPad   floor pads (BillboardGui label "Cost" optional)
--   DropperSlots.Slot1..SlotN  where droppers are built (N = max droppers on this plot)
--   Spawn                 optional; the owner is placed here when they spawn
--   Sign                  optional; SurfaceGui with TextLabels "Title" and "Subtitle"

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("TycoonKit")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local Remotes = Shared:WaitForChild("Remotes")
local Fx = Remotes:WaitForChild("Fx") :: RemoteEvent
local FxFast = Remotes:WaitForChild("FxFast") :: UnreliableRemoteEvent

local template = script.Parent:WaitForChild("Assets"):WaitForChild("DropperTemplate") :: Model

local PLOT_TAG = "TycoonPlot"
local GOLDEN_TAG = "TycoonGoldenDrop" -- clients add a sparkle to drops with this tag

type PlotState = {
	model: Model,
	owner: Player?,
	bank: number, -- cash waiting in the collector
	busy: boolean, -- a rebirth is playing
	droppers: { Model },
	nextDrop: { number },
	live: { [BasePart]: boolean },
	liveCount: number,
	dropFolder: Folder,
	belt: BasePart,
	sensor: BasePart,
	collectPad: BasePart,
	buyPad: BasePart,
	rebirthPad: BasePart,
	slots: { BasePart },
	maxDroppers: number,
}

local TycoonService = {}

local plots: { PlotState } = {}
local plotOf: { [Player]: PlotState } = {}

---------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------

local function multiplier(player: Player): number
	local p = DataService.get(player)
	local m = Config.RebirthMultiplier(if p then p.Rebirths else 0)
	return m * (ShopService.effect(player, "CashMultiplier") or 1)
end

local function dropInterval(player: Player): number
	return Config.DropInterval * (ShopService.effect(player, "DropIntervalScale") or 1)
end

local function autoCollect(player: Player): boolean
	return ShopService.effect(player, "AutoCollect") == true
end

local function setLabel(root: Instance?, name: string, text: string)
	local label = root and root:FindFirstChild(name, true)
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
end

-- Pushes the authoritative state to replicated attributes and plot labels (display only).
local function publish(plot: PlotState)
	local player = plot.owner
	local p = player and DataService.get(player)
	if not player or not p then
		return
	end
	local canBuy = p.Droppers < plot.maxDroppers
	player:SetAttribute("Cash", p.Cash)
	player:SetAttribute("Bank", plot.bank)
	player:SetAttribute("Rebirths", p.Rebirths)
	player:SetAttribute("Droppers", p.Droppers)
	player:SetAttribute("Multiplier", multiplier(player))
	player:SetAttribute("RebirthMultiplier", Config.RebirthMultiplier(p.Rebirths))
	player:SetAttribute("DropperCost", if canBuy then Config.DropperCost(p.Droppers) else -1)
	player:SetAttribute("RebirthCost", Config.RebirthCost(p.Rebirths))

	local auto = autoCollect(player)
	setLabel(plot.model:FindFirstChild("Collector"), "Value", if auto then "AUTO" else Format.cash(plot.bank))
	setLabel(plot.collectPad, "Cost", if auto then "auto: on" else "step here")
	setLabel(plot.buyPad, "Cost", if canBuy then Format.cash(Config.DropperCost(p.Droppers)) else "MAX")
	setLabel(plot.rebirthPad, "Cost", Format.cash(Config.RebirthCost(p.Rebirths)))
end

local function setSign(plot: PlotState)
	local sign = plot.model:FindFirstChild("Sign")
	local owner = plot.owner
	if owner then
		setLabel(sign, "Title", string.upper(owner.DisplayName) .. "'S TYCOON")
		local p = DataService.get(owner)
		setLabel(sign, "Subtitle", "REBIRTHS: " .. tostring(if p then p.Rebirths else 0))
	else
		setLabel(sign, "Title", "FREE PLOT")
		setLabel(sign, "Subtitle", "WAITING FOR AN OWNER")
		setLabel(plot.model:FindFirstChild("Collector"), "Value", "$0")
		setLabel(plot.collectPad, "Cost", "")
		setLabel(plot.buyPad, "Cost", "")
		setLabel(plot.rebirthPad, "Cost", "")
	end
end

local function buildDroppers(plot: PlotState, count: number, announceIndex: number?)
	count = math.clamp(count, 0, plot.maxDroppers)
	for i = #plot.droppers + 1, count do
		local m = template:Clone()
		m.Name = "Dropper" .. i
		m:PivotTo(plot.slots[i].CFrame)
		m.Parent = plot.model
		plot.droppers[i] = m
		plot.nextDrop[i] = os.clock() + 0.6 + i * 0.13
		if announceIndex == i then
			Fx:FireAllClients("DropperBuilt", plot.model, m)
		end
	end
	for i = #plot.droppers, count + 1, -1 do
		plot.droppers[i]:Destroy()
		plot.droppers[i] = nil
		plot.nextDrop[i] = nil
	end
end

local function clearDrops(plot: PlotState)
	for part in pairs(plot.live) do
		part:Destroy()
	end
	table.clear(plot.live)
	plot.liveCount = 0
end

local function spawnDrop(plot: PlotState, dropper: Model, golden: boolean)
	if plot.liveCount >= Config.MaxLiveDrops then
		return
	end
	local spout = dropper:FindFirstChild("Spout", true)
	if not (spout and spout:IsA("Attachment")) then
		return
	end
	local part = Instance.new("Part")
	part.Name = "Drop"
	part.Size = Vector3.new(1.15, 1.15, 1.15)
	part.Material = Enum.Material.SmoothPlastic
	part.Color = if golden then Color3.fromRGB(255, 200, 70) else Color3.fromRGB(70, 230, 170)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = CFrame.new(spout.WorldPosition) * CFrame.Angles(0, math.random() * math.pi, 0)
	part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.6, 0.1)
	if golden then
		part:AddTag(GOLDEN_TAG)
	end
	part.Parent = plot.dropFolder
	part:SetNetworkOwner(nil) -- the server simulates every drop (no client can move them)
	plot.live[part] = true
	plot.liveCount += 1
	task.delay(Config.DropLifetime, function()
		if plot.live[part] then -- never reached the collector
			plot.live[part] = nil
			plot.liveCount -= 1
			part:Destroy()
		end
	end)
end

local function credit(plot: PlotState, player: Player, amount: number)
	local p = DataService.get(player)
	if not p then
		return
	end
	if autoCollect(player) then
		p.Cash += amount
	else
		plot.bank += amount
	end
	publish(plot)
end

local function onSensorTouched(plot: PlotState, hit: BasePart)
	local owner = plot.owner
	if not plot.live[hit] or not owner then
		return
	end
	plot.live[hit] = nil
	plot.liveCount -= 1
	local value = math.floor(Config.DropValue * multiplier(owner) + 0.5)
	local pos = hit.Position
	local golden = hit:HasTag(GOLDEN_TAG)
	hit:Destroy()
	credit(plot, owner, value)
	FxFast:FireAllClients("Collect", plot.model, value, pos, golden)
end

local function updateNameTag(player: Player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local text = ShopService.effect(player, "NameTag")
	local tag = head:FindFirstChild("TycoonKitTag")
	if type(text) ~= "string" then
		if tag then
			tag:Destroy()
		end
		return
	end
	if tag then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "TycoonKitTag"
	gui.Size = UDim2.fromOffset(90, 30)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = Color3.fromRGB(255, 210, 90)
	label.TextStrokeTransparency = 0.4
	label.Parent = gui
	gui.Parent = head
end

---------------------------------------------------------------------------------------
-- Public API (called by Main from remotes, pads and player events)
---------------------------------------------------------------------------------------

function TycoonService.getPlot(player: Player): Model?
	local plot = plotOf[player]
	return plot and plot.model
end

-- Moves the collector's bank into the wallet.
function TycoonService.claimBank(player: Player): boolean
	local plot = plotOf[player]
	local p = DataService.get(player)
	if not plot or not p or plot.bank <= 0 then
		return false
	end
	local amount = plot.bank
	plot.bank = 0
	p.Cash += amount
	publish(plot)
	Fx:FireAllClients("BankClaimed", plot.model, amount)
	return true
end

function TycoonService.buyDropper(player: Player): boolean
	local plot = plotOf[player]
	local p = DataService.get(player)
	if not plot or not p or plot.busy then
		return false
	end
	if p.Droppers >= plot.maxDroppers then
		Fx:FireClient(player, "Denied", "All dropper slots are full")
		return false
	end
	local cost = Config.DropperCost(p.Droppers)
	if p.Cash < cost then
		Fx:FireClient(player, "Denied", "Need " .. Format.cash(cost - p.Cash) .. " more")
		return false
	end
	p.Cash -= cost
	p.Droppers += 1
	buildDroppers(plot, p.Droppers, p.Droppers)
	publish(plot)
	return true
end

function TycoonService.rebirth(player: Player): boolean
	local plot = plotOf[player]
	local p = DataService.get(player)
	if not plot or not p or plot.busy then
		return false
	end
	local cost = Config.RebirthCost(p.Rebirths)
	if p.Cash < cost then
		Fx:FireClient(player, "Denied", "Rebirth needs " .. Format.cash(cost))
		return false
	end
	plot.busy = true
	local from = Config.RebirthMultiplier(p.Rebirths)
	local to = Config.RebirthMultiplier(p.Rebirths + 1)
	Fx:FireAllClients("RebirthStart", plot.model, from, to)
	task.wait(0.9) -- the clients play the build-up; the reset lands on the flash
	-- Re-check everything after the wait: the player may have left or spent the cash.
	if plotOf[player] ~= plot or DataService.get(player) ~= p or p.Cash < cost then
		plot.busy = false
		return false
	end
	p.Rebirths += 1
	p.Cash = Config.StartCash
	p.Droppers = 1
	plot.bank = 0
	clearDrops(plot)
	buildDroppers(plot, 1)
	publish(plot)
	setSign(plot)
	Fx:FireAllClients("RebirthDone", plot.model, p.Rebirths, to)
	plot.busy = false
	return true
end

-- Called when passes change: re-applies effects and refreshes the display.
function TycoonService.refresh(player: Player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	-- Auto Collect just turned on: pay out what is waiting in the collector.
	if plot.bank > 0 and autoCollect(player) then
		TycoonService.claimBank(player)
	end
	publish(plot)
	updateNameTag(player)
end

-- Gives the player the first free plot. Returns false when every plot is taken.
function TycoonService.claimPlot(player: Player): boolean
	if plotOf[player] then
		return true
	end
	for _, plot in ipairs(plots) do
		if not plot.owner then
			plot.owner = player
			plotOf[player] = plot
			plot.model:SetAttribute("OwnerUserId", player.UserId)
			local p = DataService.get(player)
			buildDroppers(plot, if p then p.Droppers else 1)
			publish(plot)
			setSign(plot)
			player:SetAttribute("HasPlot", true)
			return true
		end
	end
	player:SetAttribute("HasPlot", false)
	warn("[TycoonKit] No free plot for " .. player.Name .. ". Add more plots (duplicate the Plot model).")
	return false
end

-- Frees the player's plot. The cash waiting in the collector goes to the wallet first,
-- so it is included in the final save.
function TycoonService.releasePlot(player: Player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	local p = DataService.get(player)
	if p and plot.bank > 0 then
		p.Cash += plot.bank
	end
	plotOf[player] = nil
	plot.owner = nil
	plot.bank = 0
	plot.busy = false
	plot.model:SetAttribute("OwnerUserId", 0)
	clearDrops(plot)
	buildDroppers(plot, 0)
	setSign(plot)
end

-- Character spawned: place it on the plot and re-apply the name tag.
function TycoonService.onCharacter(player: Player, character: Model)
	local plot = plotOf[player]
	if plot and Config.TeleportToPlotOnSpawn then
		local spawn = plot.model:FindFirstChild("Spawn")
		if spawn and spawn:IsA("BasePart") then
			character:WaitForChild("HumanoidRootPart", 5)
			task.wait() -- let the default spawn finish first
			if character.Parent then
				character:PivotTo(spawn.CFrame + Vector3.new(0, 4, 0))
			end
		end
	end
	updateNameTag(player)
end

---------------------------------------------------------------------------------------
-- Setup
---------------------------------------------------------------------------------------

local function need(parent: Instance, path: { string }): Instance
	local node = parent
	for _, name in ipairs(path) do
		local child = node:FindFirstChild(name)
		if not child then
			error(string.format("[TycoonKit] Plot '%s' is missing %s", parent:GetFullName(), table.concat(path, ".")))
		end
		node = child
	end
	return node
end

local function setupPlot(model: Model, padTouched: (PlotState, string, BasePart) -> ()): PlotState?
	local ok, result = pcall(function()
		local slots: { BasePart } = {}
		local slotFolder = need(model, { "DropperSlots" })
		local i = 1
		while slotFolder:FindFirstChild("Slot" .. i) do
			table.insert(slots, slotFolder:FindFirstChild("Slot" .. i) :: BasePart)
			i += 1
		end
		if #slots == 0 then
			error("[TycoonKit] Plot '" .. model:GetFullName() .. "' has no DropperSlots.Slot1")
		end
		local old = model:FindFirstChild("Drops")
		if old then
			old:Destroy()
		end
		local dropFolder = Instance.new("Folder")
		dropFolder.Name = "Drops"
		dropFolder.Parent = model
		local state: PlotState = {
			model = model,
			owner = nil,
			bank = 0,
			busy = false,
			droppers = {},
			nextDrop = {},
			live = {},
			liveCount = 0,
			dropFolder = dropFolder,
			belt = need(model, { "Conveyor", "Belt" }) :: BasePart,
			sensor = need(model, { "Collector", "Sensor" }) :: BasePart,
			collectPad = need(model, { "CollectPad" }) :: BasePart,
			buyPad = need(model, { "BuyDropperPad" }) :: BasePart,
			rebirthPad = need(model, { "RebirthPad" }) :: BasePart,
			slots = slots,
			maxDroppers = math.min(Config.MaxDroppers, #slots),
		}
		return state
	end)
	if not ok then
		warn(tostring(result))
		return nil
	end
	local plot = result :: PlotState

	-- Belt pushes along its own X axis, toward the collector (works for rotated plots).
	local dir = plot.belt.CFrame.RightVector
	if dir:Dot(plot.sensor.Position - plot.belt.Position) < 0 then
		dir = -dir
	end
	plot.belt.AssemblyLinearVelocity = dir * Config.ConveyorSpeed

	plot.sensor.CanTouch = true
	plot.sensor.Touched:Connect(function(hit)
		onSensorTouched(plot, hit)
	end)
	for _, pair in ipairs({ { plot.collectPad, "Collect" }, { plot.buyPad, "BuyDropper" }, { plot.rebirthPad, "Rebirth" } }) do
		local pad, action = pair[1] :: BasePart, pair[2] :: string
		pad.Touched:Connect(function(hit)
			padTouched(plot, action, hit)
		end)
	end
	model:SetAttribute("OwnerUserId", 0)
	setSign(plot)
	return plot
end

function TycoonService.start()
	-- Floor pads: only the plot's owner can use them, with a short per-player cooldown.
	local padCooldown: { [Player]: number } = {}
	local function padTouched(plot: PlotState, action: string, hit: BasePart)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player or player ~= plot.owner then
			return
		end
		local now = os.clock()
		if (padCooldown[player] or 0) > now then
			return
		end
		padCooldown[player] = now + Config.PadCooldown
		if action == "Collect" then
			TycoonService.claimBank(player)
		elseif action == "BuyDropper" then
			TycoonService.buyDropper(player)
		elseif action == "Rebirth" then
			TycoonService.rebirth(player)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		padCooldown[player] = nil
	end)

	for _, model in ipairs(CollectionService:GetTagged(PLOT_TAG)) do
		if model:IsA("Model") and model:IsDescendantOf(workspace) then
			local plot = setupPlot(model, padTouched)
			if plot then
				table.insert(plots, plot)
			end
		end
	end
	-- Stable order: plots sorted by name, so "first free plot" is predictable.
	table.sort(plots, function(a, b)
		return a.model:GetFullName() < b.model:GetFullName()
	end)
	if #plots == 0 then
		warn("[TycoonKit] No plot found. Keep the Plot model (tag 'TycoonPlot') in Workspace.")
	end

	-- One scheduler for every dropper of every plot.
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for _, plot in ipairs(plots) do
			local player = plot.owner
			if player and not plot.busy then
				local interval = dropInterval(player)
				local golden = ShopService.effect(player, "GoldenDrops") == true
				for i, dropper in ipairs(plot.droppers) do
					if now >= plot.nextDrop[i] then
						plot.nextDrop[i] = now + interval
						spawnDrop(plot, dropper, golden)
					end
				end
			end
		end
	end)
end

return TycoonService
