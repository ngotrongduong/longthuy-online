      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">README</string>
          <string name="Source"><![CDATA[--[[
================================================================================
 TYCOON SYSTEMS KIT  -  README
================================================================================

 A working, server-authoritative tycoon core you drop into your own game:
 droppers, conveyor and collector, dropper upgrades, rebirth with a permanent
 multiplier, a Robux shop (game passes + developer products), DataStore saving
 with a session lock, and a HUD that scales from phones to PC.

 Written in plain Luau, readable and commented. Every script is inside this
 model: nothing is downloaded or loaded from other assets at run time, no code
 is built from strings, nothing is obfuscated, and no uploaded images or sounds
 are needed (effects use Roblox's built-in rbxasset:// textures).

--------------------------------------------------------------------------------
 SETUP IN 3 STEPS
--------------------------------------------------------------------------------
 1. Insert the model. Keep "TycoonSystemsKit" in Workspace. Move the Plot where
    you want it (duplicate the Plot for more players: one plot per player in a
    server; every copy keeps the "TycoonPlot" tag).
 2. Open Shared > Config. Put your own game pass ids and developer product ids
    where it says "replace with your ... id" (Id = 0 means "not for sale yet").
    Tune prices, multipliers, dropper speed, rebirth curve, autosave there too.
 3. To save progress: publish the place, then Game Settings > Security >
    "Enable Studio Access to API Services" (only needed to test saving in
    Studio; live servers always save). Press Play.

 The Installer script does the rest each time a server starts:
   Shared -> ReplicatedStorage.TycoonKit
   Server -> ServerScriptService.TycoonKit   (Main is enabled by the Installer)
   Client -> StarterPlayer.StarterPlayerScripts.TycoonKit
   Plot(s) -> Workspace.TycoonPlots
 Prefer a permanent install? Do those moves yourself in Studio, rename each
 folder to "TycoonKit", set ServerScriptService.TycoonKit.Main Enabled = true,
 and delete the empty model with the Installer.

--------------------------------------------------------------------------------
 WHAT IS INSIDE
--------------------------------------------------------------------------------
 Shared/Config        every number and every pass/product (start here)
 Shared/Format        $1,234 / $3.40M / x1.5 formatting
 Shared/Remotes       Action (client -> server requests), Fx, FxFast (server -> clients)
 Server/Main          starts the services, player join/leave, checks every request
 Server/DataService   profiles: UpdateAsync session lock (JobId + time), retries
                      with backoff, autosave, BindToClose, refuses to save when
                      the lock was taken by another server
 Server/ShopService   game passes (UserOwnsGamePassAsync on join +
                      PromptGamePassPurchaseFinished) and developer products
                      (ProcessReceipt, each purchase granted once and saved
                      before it is confirmed)
 Server/TycoonService plots, droppers, conveyor, collector, upgrades, rebirth
 Server/Assets/DropperTemplate   the dropper model that is built on each slot
 Client/Hud           stat cards, buttons, toasts, shop window
 Client/Effects       particles and moments (sell, collect, build, rebirth)
 Plot                 example plot (tag "TycoonPlot")

--------------------------------------------------------------------------------
 HOW IT PLAYS
--------------------------------------------------------------------------------
 * Each player gets the first free plot on join and is placed on it.
 * Droppers drop on the belt; the collector sells each drop for
   DropValue x rebirth multiplier x pass multipliers. Cash waits in the
   collector until the player steps on COLLECT (or owns Auto Collect).
 * BUY DROPPER (pad or HUD) builds the next dropper; REBIRTH resets cash and
   droppers for a permanent +RebirthBonus multiplier. The HUD asks for a
   second tap before a rebirth.
 * SHOP lists every game pass and developer product from Config.

--------------------------------------------------------------------------------
 MAKING IT YOURS
--------------------------------------------------------------------------------
 * New pass: add an entry to Config.Passes with Effects (CashMultiplier,
   DropIntervalScale, AutoCollect, GoldenDrops, NameTag). No other code needed.
 * Try the pass effects for free in Studio: Config.StudioOwnsAllPasses = true
   (ignored on live servers).
 * New product: add an entry to Config.Products with Grant = { Cash = n }, or
   write a custom reward in ShopService.ProductRewards.
 * More dropper slots: add Slot7, Slot8 ... parts in Plot.DropperSlots and raise
   Config.MaxDroppers.
 * New look: restyle the Plot and Server/Assets/DropperTemplate freely. Keep the
   names listed at the top of TycoonService (Belt, Sensor, pads, slots, Spout).
 * Already have a ProcessReceipt in your game? Only one script may set it. Remove
   the line "MarketplaceService.ProcessReceipt = processReceipt" in ShopService
   and call ShopService.processReceipt(receipt) from your own handler for this
   kit's product ids.
 * Saved data: the DataStore is Config.DataStoreName; keys are "player_<UserId>".

--------------------------------------------------------------------------------
 WHAT IT DOES NOT DO
--------------------------------------------------------------------------------
 * It is a systems core, not a finished game: one plot design, one dropper
   type, no walls/doors/buttons-to-buy-buildings progression, no pets,
   no leaderboards, no sounds, no tutorial.
 * Prices on the shop cards are typed in Config; Roblox charges what you set
   on the Creator Dashboard. Keep them the same.
 * In Studio without API access nothing is saved (a warning says so and the
   HUD shows "Studio test: not saved").
 * Game passes and products cannot be really bought in Studio; Studio shows
   Roblox's test purchase dialog when the ids are real.

 Support: see the Creator Store page of this model.
================================================================================
]]

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="5">
        <Properties>
          <string name="Name">Installer</string>
          <string name="Source"><![CDATA[-- Installer: sets the Tycoon Systems Kit up when the game starts.
--
-- Leave the TycoonSystemsKit model in Workspace and press Play. On the server this
-- script moves every part of the kit to the place where Roblox runs it:
--
--   TycoonSystemsKit.Shared  ->  ReplicatedStorage.TycoonKit            (Config, Format, Remotes)
--   TycoonSystemsKit.Server  ->  ServerScriptService.TycoonKit          (Main + services; Main is enabled)
--   TycoonSystemsKit.Client  ->  StarterPlayer.StarterPlayerScripts.TycoonKit  (Hud, Effects)
--   every plot (tag "TycoonPlot") inside the kit  ->  Workspace.TycoonPlots
--
-- Then the empty kit model is removed. Nothing is changed in your saved place: the move
-- happens again, the same way, every time a server starts.
--
-- Prefer a permanent install? In Studio (not playing) drag the folders to the places
-- above yourself, rename each to "TycoonKit", set ServerScriptService.TycoonKit.Main
-- Enabled = true, move the Plot to Workspace and delete this model. See README.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local StarterPlayer = game:GetService("StarterPlayer")
local CollectionService = game:GetService("CollectionService")

local kit = script.Parent
local playerScripts = StarterPlayer:WaitForChild("StarterPlayerScripts")

if ReplicatedStorage:FindFirstChild("TycoonKit") or ServerScriptService:FindFirstChild("TycoonKit") then
	warn("[TycoonKit] The kit is already installed in this place; the TycoonSystemsKit model was ignored. Delete one of the two copies.")
	return
end

local function move(name: string, destination: Instance): Instance?
	local folder = kit:FindFirstChild(name)
	if not folder then
		warn("[TycoonKit] Installer: '" .. name .. "' is missing from the TycoonSystemsKit model.")
		return nil
	end
	folder.Name = "TycoonKit"
	folder.Parent = destination
	return folder
end

-- 1. Shared code and remotes first: everything else waits for them.
move("Shared", ReplicatedStorage)

-- 2. Plots: out of the kit, into one folder, at the same world position.
local plotFolder = workspace:FindFirstChild("TycoonPlots") or Instance.new("Folder")
plotFolder.Name = "TycoonPlots"
plotFolder.Parent = workspace
for _, plot in ipairs(CollectionService:GetTagged("TycoonPlot")) do
	if plot:IsDescendantOf(kit) then
		plot.Parent = plotFolder
	end
end

-- 3. Client scripts. Players who are already in the server (possible in Studio) got
--    their StarterPlayerScripts before this ran, so they get a copy in PlayerGui. The
--    scripts themselves make sure only one copy runs per player.
local client = move("Client", playerScripts)
if client then
	for _, player in ipairs(Players:GetPlayers()) do
		local playerGui = player:FindFirstChildOfClass("PlayerGui")
		if playerGui then
			local holder = Instance.new("ScreenGui")
			holder.Name = "TycoonKitLateJoin"
			holder.ResetOnSpawn = false
			for _, child in ipairs(client:GetChildren()) do
				child:Clone().Parent = holder
			end
			holder.Parent = playerGui
		end
	end
end

-- 4. Server code last, then start it.
local server = move("Server", ServerScriptService)
local main = server and server:FindFirstChild("Main")
if main and main:IsA("Script") then
	main.Enabled = true
else
	warn("[TycoonKit] Installer: ServerScriptService.TycoonKit.Main not found; the kit is not running.")
end

-- 5. The README and this Installer are not needed at run time.
kit:Destroy()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="6">
        <Properties>
          <string name="Name">Shared</string>
        </Properties>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Config</string>
            <string name="Source"><![CDATA[--!strict
-- Config: EVERY tunable of the Tycoon Systems Kit lives here.
--
-- Installed at: ReplicatedStorage.TycoonKit.Config
-- Both the server and the clients read this module. Only the SERVER acts on the values
-- (money, prices, purchases); the client uses them to draw the HUD and the shop.
-- Nothing secret belongs here: clients can read it.
--
-- After changing a value, press Play: no other file needs editing for the numbers below.

local Config = {}

---------------------------------------------------------------------------------------
-- Economy
---------------------------------------------------------------------------------------
Config.StartCash = 0 -- cash of a brand-new player, and after each rebirth
Config.DropValue = 15 -- cash per collected drop, before multipliers
Config.DropInterval = 0.9 -- seconds between two drops of ONE dropper
Config.ConveyorSpeed = 13 -- studs per second the belt pushes drops toward the collector
Config.MaxLiveDrops = 60 -- hard cap of drop parts alive on one plot (protects the server)
Config.DropLifetime = 20 -- seconds before a drop that never reached the collector is removed

-- Droppers: the first one is free. The plot has one slot per dropper (Plot.DropperSlots);
-- the real maximum is the smaller of MaxDroppers and the number of slots.
Config.MaxDroppers = 6
Config.DropperBaseCost = 150 -- price of the 2nd dropper
Config.DropperCostGrowth = 1.6 -- each next dropper costs this much more

-- Price of the next dropper when the player owns `owned` droppers.
function Config.DropperCost(owned: number): number
	return math.floor(Config.DropperBaseCost * Config.DropperCostGrowth ^ (owned - 1) + 0.5)
end

---------------------------------------------------------------------------------------
-- Rebirth: resets cash and droppers, keeps a PERMANENT cash multiplier.
---------------------------------------------------------------------------------------
Config.RebirthBaseCost = 1000 -- price of the first rebirth
Config.RebirthCostGrowth = 2.5 -- each next rebirth costs this much more
Config.RebirthBonus = 0.5 -- +0.5x permanent multiplier per rebirth (1x, 1.5x, 2x, ...)

function Config.RebirthCost(rebirths: number): number
	return math.floor(Config.RebirthBaseCost * Config.RebirthCostGrowth ^ rebirths + 0.5)
end

function Config.RebirthMultiplier(rebirths: number): number
	return 1 + Config.RebirthBonus * rebirths
end

---------------------------------------------------------------------------------------
-- Game passes
--
--   REPLACE Id = 0 WITH YOUR OWN PASS IDS (Creator Dashboard > your experience >
--   Monetization > Passes). While Id is 0 the pass is shown in the shop but cannot be
--   bought, and the server never asks Roblox about it (it is treated as not owned).
--
--   Price is only the number SHOWN in the shop. Roblox charges the price you set on the
--   Creator Dashboard, so keep the two the same.
--
--   Effects the server understands (combine freely, add your own passes):
--     CashMultiplier = 2      every drop is worth 2x (multiplies with rebirth and other passes)
--     DropIntervalScale = 0.8 droppers drop 20% faster
--     AutoCollect = true      cash goes straight to the wallet, no collect pad needed
--     GoldenDrops = true      drops look golden (visual only)
--     NameTag = "VIP"         a tag above the player's head
---------------------------------------------------------------------------------------
-- Studio only: true = you own every pass while testing in Studio (try the effects for
-- free). Live servers ignore it. Leave false to test the real purchase prompts.
Config.StudioOwnsAllPasses = false

Config.Passes = {
	{
		Key = "DoubleCash", -- internal name, must be unique, letters only
		Id = 0, -- <-- replace with your game pass id
		Name = "2x Cash",
		Blurb = "Every drop is worth double.",
		Price = 149,
		Color = Color3.fromRGB(255, 196, 64),
		Icon = "2x",
		Effects = { CashMultiplier = 2, GoldenDrops = true },
	},
	{
		Key = "AutoCollect",
		Id = 0, -- <-- replace with your game pass id
		Name = "Auto Collect",
		Blurb = "Cash goes straight to your wallet.",
		Price = 99,
		Color = Color3.fromRGB(80, 214, 255),
		Icon = "AC",
		Effects = { AutoCollect = true },
	},
	{
		Key = "VIP",
		Id = 0, -- <-- replace with your game pass id
		Name = "VIP",
		Blurb = "+25% cash, faster droppers, gold tag.",
		Price = 249,
		Color = Color3.fromRGB(196, 120, 255),
		Icon = "VIP",
		Effects = { CashMultiplier = 1.25, DropIntervalScale = 0.8, NameTag = "VIP" },
	},
}

---------------------------------------------------------------------------------------
-- Developer products (can be bought many times). Granted through ProcessReceipt:
-- each purchase is granted exactly once and saved before Roblox is told it was granted.
--
--   REPLACE Id = 0 WITH YOUR OWN PRODUCT IDS (Creator Dashboard > Monetization >
--   Developer Products). Grant.Cash is the cash given. For other rewards, add a handler
--   in ShopService (see "Custom product rewards" there).
---------------------------------------------------------------------------------------
Config.Products = {
	{
		Key = "CashPack",
		Id = 0, -- <-- replace with your developer product id
		Name = "Cash Pack",
		Blurb = "+$5,000 cash, right now.",
		Price = 49,
		Color = Color3.fromRGB(64, 226, 146),
		Icon = "$",
		Grant = { Cash = 5000 },
	},
}

---------------------------------------------------------------------------------------
-- Saving (DataStoreService)
---------------------------------------------------------------------------------------
Config.DataStoreName = "TycoonKitProfiles_v1" -- change the name to start everyone fresh
Config.AutosaveSeconds = 60 -- autosave interval; it also refreshes the session lock
-- A session lock older than this is treated as left behind by a crashed server.
-- Must stay well above AutosaveSeconds (the kit uses at least 3x AutosaveSeconds).
Config.SessionLockTimeout = 300
Config.LoadRetries = 5 -- tries to take the profile before the player is asked to rejoin
Config.ReceiptHistory = 50 -- developer-product purchase ids remembered per player
-- In Studio without "Enable Studio Access to API Services" DataStores are unreachable.
-- true: play anyway with in-memory profiles (nothing is saved, a warning says so).
Config.StudioMemoryFallback = true

---------------------------------------------------------------------------------------
-- Anti-spam and misc
---------------------------------------------------------------------------------------
Config.RequestInterval = 0.2 -- minimum seconds between two requests of one player
Config.PadCooldown = 0.8 -- seconds before the same player can trigger a floor pad again
Config.TeleportToPlotOnSpawn = true -- put each player on their own plot when they spawn
Config.EffectsMaxDistance = 220 -- clients skip world effects of plots farther than this

return Config
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Format: number formatting shared by the HUD, the plot signs and the effects.
-- Installed at: ReplicatedStorage.TycoonKit.Format

local Format = {}

local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234567 -> "1,234,567"
function Format.commas(n: number): string
	local s = tostring(math.floor(n + 0.5))
	local sign, digits = s:match("^(-?)(%d+)$")
	if not digits then
		return s -- inf / nan: show as is
	end
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (sign or "") .. out
end

-- 950 -> "$950", 12500 -> "$12,500", 3400000 -> "$3.40M"
function Format.cash(n: number): string
	if math.abs(n) < 1e6 then
		return "$" .. Format.commas(n)
	end
	local i = math.min(math.floor(math.log10(math.abs(n)) / 3), #SUFFIXES)
	return string.format("$%.2f%s", n / 10 ^ (i * 3), SUFFIXES[i])
end

-- 2 -> "x2", 1.5 -> "x1.5", 2.25 -> "x2.25"
function Format.mult(n: number): string
	if n == math.floor(n) then
		return string.format("x%d", n)
	end
	local s = string.format("%.2f", n):gsub("0+$", "")
	return "x" .. s
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="9">
