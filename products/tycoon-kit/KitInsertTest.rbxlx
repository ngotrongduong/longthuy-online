	local fill = new("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = color, BackgroundTransparency = 0.78 }, b)
	corner(fill, 18)
	local titleLabel = new("TextLabel", {
		Name = "Title",
