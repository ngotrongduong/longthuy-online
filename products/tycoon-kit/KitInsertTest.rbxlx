	}, b)
	local cost = new("TextLabel", {
		Name = "Cost",
		Position = UDim2.fromOffset(20, 38),
		Size = UDim2.fromOffset(170, 20),
		Text = "",
		Font = BOLD,
		TextSize = 16,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, b)
	local badge = new("Frame", {
		Name = "Badge",
