			Visible = false,
			ZIndex = 30,
		}, card)
		corner(check, 24)
		stroke(check, Color3.fromRGB(14, 16, 24), 0, 4)
		checkMark(check, Color3.fromRGB(14, 16, 24), 48, 31)
		new("UIScale", { Scale = 0 }, check)
		passCards[data.Key] = { buy = buy, price = price, icon = icon, check = check, stroke = st, scale = cardScale }
		buy.Activated:Connect(function()
			if player:GetAttribute("Pass_" .. data.Key) ~= true then
				Action:FireServer("PromptPass", data.Key)
			end
		end)
	else
		buy.Activated:Connect(function()
			Action:FireServer("PromptProduct", data.Key)
		end)
	end
end

local shopOpen = false
local function shopFitScale(): number
	local size = root.AbsoluteSize
	-- On phones the shop may use the whole screen (the touch controls are hidden then).
	local base = if isTouch then math.max(uiScale, 0.75) else uiScale
	return math.min(base, size.X * 0.96 / SHOP_W, size.Y * 0.94 / SHOP_H)
end
local function setShop(open: boolean)
	if open == shopOpen then
		return
	end
	shopOpen = open
	if isTouch then
		-- The thumbstick and jump button would cover the buy buttons on small phones.
		GuiService.TouchControlsEnabled = not open
	end
	local k = shopFitScale()
	if open then
		shop.Visible = true
		shade.Visible = true
		shopScale.Scale = k * 0.85
		tween(shopScale, 0.45, { Scale = k }, Enum.EasingStyle.Back)
		tween(shade, 0.3, { BackgroundTransparency = 0.55 })
		tween(blur, 0.3, { Size = 14 })
	else
		tween(shopScale, 0.22, { Scale = k * 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(shade, 0.25, { BackgroundTransparency = 1 })
		tween(blur, 0.25, { Size = 0 })
		task.delay(0.22, function()
			if not shopOpen then
				shop.Visible = false
				shade.Visible = false
			end
		end)
	end
end

local function setOwnedVisual(key: string, owned: boolean, animate: boolean)
	local pc = passCards[key]
	if not pc then
		return
	end
	local checkScale = pc.check:FindFirstChildOfClass("UIScale") :: UIScale
	if owned then
		pc.price.Text = "OWNED"
		pc.icon.Visible = false
		pc.price.AnchorPoint = Vector2.new(0.5, 0.5)
		pc.price.Position = UDim2.fromScale(0.5, 0.5)
		pc.price.TextXAlignment = Enum.TextXAlignment.Center
		pc.buy.BackgroundColor3 = THEME.Cash
		pc.buy.AutoButtonColor = false
		pc.stroke.Color = THEME.Cash
		pc.stroke.Transparency = 0.1
		pc.check.Visible = true
		if animate then
			checkScale.Scale = 0
			tween(checkScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
			pc.scale.Scale = 1.06
			tween(pc.scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		else
			checkScale.Scale = 1
		end
	else
		pc.check.Visible = false
	end
end

-- Layout scale ------------------------------------------------------------------------
local JUMP_RESERVE = 110 -- px kept free at the bottom right for Roblox's touch jump button
local function updateScale()
	local size = root.AbsoluteSize
	-- Keep the stat cards below Roblox's own top bar buttons.
	local top = GuiService.TopbarInset.Height
	if top <= 0 then
		top = GuiService:GetGuiInset().Y
	end
	local rootScreenY = root.AbsolutePosition.Y + GuiService:GetGuiInset().Y
	local y = math.max(22, top - rootScreenY + 14)

	local k = math.min(size.X / 1280, size.Y / 720) * 0.85
	if isTouch then
		k = math.max(k, 0.62) -- keep touch targets big on small phones...
		-- ...but the right column (status 78 + buttons 230) must end above the jump button.
		k = math.min(k, (size.Y - y - JUMP_RESERVE) / 308)
	end
	k = math.clamp(k, 0.45, 3)
	uiScale = k
	for _, s in ipairs(scales) do
		s.Scale = k
	end
	if shopOpen then
		shopScale.Scale = shopFitScale()
	end
	stats.Position = UDim2.new(0, 22, 0, y)
	if isTouch then
		-- Touch: actions sit under the save pill / boosts column on the right.
		topRight.Position = UDim2.new(1, -22, 0, y)
		actions.Position = UDim2.new(1, -22, 0, y + 78 * k)
	end
end

-- Live values -------------------------------------------------------------------------
local shownCash = 0
local targetCash = 0
local lastCash: number? = nil

local function pop(label: TextLabel, size: number)
	label.TextSize = size + 6
	tween(label, 0.35, { TextSize = size }, Enum.EasingStyle.Back)
end

local rebirthArmedUntil = 0
local function refreshButtons()
	local cash = (player:GetAttribute("Cash") or 0) :: number
	local dCost = (player:GetAttribute("DropperCost") or 0) :: number
	local rCost = (player:GetAttribute("RebirthCost") or 1) :: number
	if dCost < 0 then
		buyCost.Text = "MAX"
		buyFill.Size = UDim2.fromScale(1, 1)
	else
		buyCost.Text = Format.cash(dCost)
		tween(buyFill, 0.25, { Size = UDim2.fromScale(math.clamp(cash / math.max(dCost, 1), 0, 1), 1) })
	end
	local nextMult = Config.RebirthMultiplier(((player:GetAttribute("Rebirths") or 0) :: number) + 1)
	if os.clock() < rebirthArmedUntil then
		rebTitle.Text = "TAP TO CONFIRM"
		rebCost.Text = "Resets cash & droppers"
	else
		rebTitle.Text = "REBIRTH"
		rebCost.Text = Format.cash(rCost) .. "  ->  " .. Format.mult(nextMult)
	end
	tween(rebFill, 0.25, { Size = UDim2.fromScale(math.clamp(cash / math.max(rCost, 1), 0, 1), 1) })
end

local function onCash()
	local cash = (player:GetAttribute("Cash") or 0) :: number
	targetCash = cash
	if lastCash then
		local delta = cash - lastCash
		if delta >= 1 then
			flyout("+" .. Format.cash(delta), THEME.Cash)
		elseif delta <= -1 then
			flyout("-" .. Format.cash(-delta), THEME.Red)
		end
	end
	lastCash = cash
	refreshButtons()
end

local function onMultiplier()
	local m = (player:GetAttribute("Multiplier") or 1) :: number
	local r = (player:GetAttribute("RebirthMultiplier") or 1) :: number
	local before = multValue.Text
	multValue.Text = Format.mult(m)
	local parts = {}
	if r > 1 then
		table.insert(parts, "rebirth " .. Format.mult(r))
	end
	local passMult = m / math.max(r, 0.001)
	if passMult > 1.001 then
		table.insert(parts, "passes " .. Format.mult(math.floor(passMult * 100 + 0.5) / 100))
	end
	multDetail.Text = table.concat(parts, "\n")
	if before ~= multValue.Text then
		pop(multValue, 27)
	end
end

local function onRebirths()
	local before = rebValue.Text
	rebValue.Text = tostring(player:GetAttribute("Rebirths") or 0)
	if before ~= rebValue.Text then
		pop(rebValue, 27)
	end
	refreshButtons()
end

local function onSave()
	local mode = player:GetAttribute("SaveMode")
	saveText.Text = (player:GetAttribute("SaveStatus") or "Loading profile...") :: string
	saveDot.BackgroundColor3 = if mode == "DataStore" then THEME.Cash else THEME.Gold
end

local passKnown: { [string]: boolean } = {}
local function onPass(key: string)
	local owned = player:GetAttribute("Pass_" .. key) == true
	local was = passKnown[key]
	passKnown[key] = owned
	local justBought = was == false and owned
	setOwnedVisual(key, owned, justBought)
	local chip = boostChips[key]
	if chip then
		chip.Visible = owned
		if justBought then
			local s = chip:FindFirstChildOfClass("UIScale") :: UIScale
			s.Scale = 0.4
			tween(s, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
	if justBought then
		for _, pass in ipairs(Config.Passes) do
			if pass.Key == key then
				toast(string.upper(pass.Name) .. " UNLOCKED", pass.Color)
			end
		end
	end
	onMultiplier()
end

player:GetAttributeChangedSignal("Cash"):Connect(onCash)
player:GetAttributeChangedSignal("DropperCost"):Connect(refreshButtons)
player:GetAttributeChangedSignal("RebirthCost"):Connect(refreshButtons)
player:GetAttributeChangedSignal("Multiplier"):Connect(onMultiplier)
player:GetAttributeChangedSignal("RebirthMultiplier"):Connect(onMultiplier)
player:GetAttributeChangedSignal("Rebirths"):Connect(onRebirths)
player:GetAttributeChangedSignal("SaveStatus"):Connect(onSave)
player:GetAttributeChangedSignal("SaveMode"):Connect(onSave)
player:GetAttributeChangedSignal("HasPlot"):Connect(function()
	if player:GetAttribute("HasPlot") == false then
		toast("All plots are taken in this server", THEME.Red)
	end
end)
for _, pass in ipairs(Config.Passes) do
	passKnown[pass.Key] = player:GetAttribute("Pass_" .. pass.Key) == true
	player:GetAttributeChangedSignal("Pass_" .. pass.Key):Connect(function()
		onPass(pass.Key)
	end)
end

-- Rolling cash counter
RunService.RenderStepped:Connect(function(dt)
	if math.abs(targetCash - shownCash) < 1 then
		shownCash = targetCash
	else
		shownCash += (targetCash - shownCash) * math.min(1, dt * 9)
	end
	cashValue.Text = Format.cash(shownCash)
end)

-- Buttons -----------------------------------------------------------------------------
buyBtn.Activated:Connect(function()
	ripple(buyBtn, buyPress)
	Action:FireServer("BuyDropper")
end)
rebBtn.Activated:Connect(function()
	ripple(rebBtn, rebPress)
	-- Rebirth wipes cash and droppers, so the button asks for a second tap.
	if os.clock() < rebirthArmedUntil then
		rebirthArmedUntil = 0
		refreshButtons()
		Action:FireServer("Rebirth")
		return
	end
	local cash = (player:GetAttribute("Cash") or 0) :: number
	local rCost = (player:GetAttribute("RebirthCost") or 1) :: number
	if cash < rCost then
		toast("Rebirth needs " .. Format.cash(rCost), THEME.Red)
		return
	end
	rebirthArmedUntil = os.clock() + 3
	refreshButtons()
	task.delay(3.05, refreshButtons)
end)
shopBtn.Activated:Connect(function()
	ripple(shopBtn, shopPress)
	setShop(not shopOpen)
end)
closeBtn.Activated:Connect(function()
	setShop(false)
end)
shade.Activated:Connect(function()
	setShop(false) -- tap outside the panel closes it
end)

-- Messages from the server
Fx.OnClientEvent:Connect(function(kind, a, b, c)
	if kind == "Denied" then
		toast(tostring(a), THEME.Red)
	elseif kind == "ProductGranted" then
		toast("THANK YOU! " .. string.upper(tostring(a)) .. " RECEIVED", THEME.Cash)
	elseif kind == "RebirthDone" and typeof(a) == "Instance" and a:GetAttribute("OwnerUserId") == player.UserId then
		toast("REBIRTH " .. tostring(b) .. "  ·  PERMANENT " .. Format.mult(c), THEME.Purple)
	end
end)

root:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateScale)
root:GetPropertyChangedSignal("AbsolutePosition"):Connect(updateScale)
updateScale()
onCash()
onMultiplier()
onRebirths()
onSave()
for _, pass in ipairs(Config.Passes) do
	onPass(pass.Key)
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="30">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Effects: every visual effect of the kit is made here, on the client.
-- Installed at: StarterPlayer.StarterPlayerScripts.TycoonKit.Effects
--
-- The server only says WHAT happened and on which plot (remote events); it never builds
-- or replicates effect instances. Each effect has a bounded lifetime and cleans up after
-- itself. Effects of plots farther than Config.EffectsMaxDistance are skipped, and the
-- camera / lighting moments (rebirth) play only for the plot's owner.
-- Textures are Roblox's built-in particle textures (rbxasset://), no uploads needed.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
if player:GetAttribute("TycoonKitEffects") then
	return -- already running (see the note in Hud)
end
player:SetAttribute("TycoonKitEffects", true)

local Shared = ReplicatedStorage:WaitForChild("TycoonKit")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = Shared:WaitForChild("Remotes")
local Fx = Remotes:WaitForChild("Fx")
local FxFast = Remotes:WaitForChild("FxFast")

local TEX = {
	Spark = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	Shock = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
}
local TEAL = Color3.fromRGB(46, 214, 170)
local PURPLE = Color3.fromRGB(160, 96, 255)
local GOLD = Color3.fromRGB(255, 200, 70)

local fxFolder = Instance.new("Folder")
fxFolder.Name = "TycoonKitClientFx"
fxFolder.Parent = workspace

local function tween(o: Instance, t: number, props, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function seq(points: { { number } }): NumberSequence
	local kps = {}
	for _, p in ipairs(points) do
		table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return NumberSequence.new(kps)
end

local function isPlot(value: any): boolean
	return typeof(value) == "Instance" and value:IsA("Model") and value:IsDescendantOf(workspace)
end

local function isMine(plot: Model): boolean
	return plot:GetAttribute("OwnerUserId") == player.UserId
end

local function plotCenter(plot: Model): Vector3
	local cf = plot:GetBoundingBox()
	local floor = plot:FindFirstChild("Floor")
	local y = if floor and floor:IsA("BasePart") then floor.Position.Y + floor.Size.Y / 2 + 0.2 else cf.Position.Y
	return Vector3.new(cf.Position.X, y, cf.Position.Z)
end

local function nearCamera(pos: Vector3): boolean
	local camera = workspace.CurrentCamera
	return camera ~= nil and (camera.CFrame.Position - pos).Magnitude <= Config.EffectsMaxDistance
end

-- An invisible, anchored, non-colliding holder part for emitters, removed after `life` s.
local function holder(cf: CFrame, size: Vector3, life: number): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = size
	p.CFrame = cf
	p.Parent = fxFolder
	task.delay(life, function()
		p:Destroy()
	end)
	return p
end

local function emitter(parent: Instance, props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Texture = TEX.Spark
	for k, v in pairs(props) do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

-- Flat shockwave ring on the ground: one particle lying flat that grows and fades.
local function ring(center: Vector3, color: Color3, from: number, to: number, t: number)
	local h = holder(CFrame.new(center), Vector3.new(0.2, 0.2, 0.2), t + 0.2)
	emitter(h, {
		Texture = TEX.Shock,
		Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
		EmissionDirection = Enum.NormalId.Top,
		Speed = NumberRange.new(0.01),
		Lifetime = NumberRange.new(t),
		Size = seq({ { 0, from }, { 0.35, from + (to - from) * 0.75 }, { 1, to } }),
		Transparency = seq({ { 0, 0.05 }, { 0.5, 0.35 }, { 1, 1 } }),
		Color = ColorSequence.new(color),
		ZOffset = 0.5,
	}):Emit(1)
end

local liveTexts = 0
local function floatText(pos: Vector3, text: string, color: Color3, size: number, rise: number, life: number)
	local att = holder(CFrame.new(pos), Vector3.one, life + 0.1)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(220, 60)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 150
	bb.Parent = att
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Text = text
	l.Font = Enum.Font.GothamBlack
	l.TextSize = size
	l.TextColor3 = color
	l.TextStrokeColor3 = Color3.fromRGB(10, 12, 18)
	l.TextStrokeTransparency = 0.35
	l.Parent = bb
	local sc = Instance.new("UIScale")
	sc.Scale = 0.5
	sc.Parent = l
	tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(bb, life, { StudsOffsetWorldSpace = Vector3.new(0, rise, 0) }, Enum.EasingStyle.Quad)
	task.delay(life * 0.55, function()
		tween(l, life * 0.45, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quad)
	end)
end

-- Collector: a spray at the intake and a floating "+$" for every sold drop ----------
type IntakeFx = { part: BasePart, emitter: ParticleEmitter, baseColor: Color3 }
local intakes: { [Model]: IntakeFx } = {}

local function intakeFor(plot: Model): IntakeFx?
	local cached = intakes[plot]
	if cached and cached.part.Parent then
		return cached
	end
	local collector = plot:FindFirstChild("Collector")
	local intake = collector and collector:FindFirstChild("Intake")
	if not (intake and intake:IsA("BasePart")) then
		return nil
	end
	local fx: IntakeFx = {
		part = intake,
		baseColor = intake.Color,
		emitter = emitter(intake, {
			Color = ColorSequence.new(TEAL),
			Size = seq({ { 0, 0.5 }, { 1, 0 } }),
			Transparency = seq({ { 0, 0.1 }, { 1, 1 } }),
			Lifetime = NumberRange.new(0.4, 0.7),
			Speed = NumberRange.new(6, 10),
			SpreadAngle = Vector2.new(40, 40),
			EmissionDirection = Enum.NormalId.Left, -- the intake's -X face looks at the belt
			Acceleration = Vector3.new(0, -12, 0),
		}),
	}
	intakes[plot] = fx
	return fx
end

local function onCollect(plot: Model, value: number, pos: Vector3, golden: boolean)
	if not nearCamera(pos) then
		return
	end
	local fx = intakeFor(plot)
	if fx then
		fx.emitter.Color = ColorSequence.new(if golden then GOLD else TEAL)
		fx.emitter:Emit(3)
		fx.part.Color = if golden then GOLD else Color3.fromRGB(120, 255, 220)
		tween(fx.part, 0.25, { Color = fx.baseColor }, Enum.EasingStyle.Quad)
	end
	-- Numbers only for your own plot, and at most 10 at once.
	if isMine(plot) and liveTexts < 10 then
		liveTexts += 1
		floatText(pos + Vector3.new(-0.5, 2.2, 0), "+" .. Format.cash(value), if golden then GOLD else Color3.fromRGB(120, 255, 200), 26, 4, 0.9)
		task.delay(0.9, function()
			liveTexts -= 1
		end)
	end
end

local function onBankClaimed(plot: Model, amount: number)
	local pad = plot:FindFirstChild("CollectPad")
	if not (pad and pad:IsA("BasePart")) then
		return
	end
	local pos = pad.Position + Vector3.new(0, 0.6, 0)
	if not nearCamera(pos) then
		return
	end
	local h = holder(CFrame.new(pos), Vector3.new(6, 0.2, 6), 2.5)
	emitter(h, {
		Color = ColorSequence.new(GOLD, Color3.fromRGB(255, 240, 180)),
		Size = seq({ { 0, 0.9 }, { 0.6, 0.6 }, { 1, 0 } }),
		Transparency = seq({ { 0, 0 }, { 0.8, 0.2 }, { 1, 1 } }),
		Lifetime = NumberRange.new(0.8, 1.3),
		Speed = NumberRange.new(16, 28),
		SpreadAngle = Vector2.new(35, 35),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -40, 0),
		Drag = 1.5,
		RotSpeed = NumberRange.new(-200, 200),
		Shape = Enum.ParticleEmitterShape.Box,
	}):Emit(36)
	ring(pos, GOLD, 4, 18, 0.6)
	floatText(pos + Vector3.new(0, 5, 0), "+" .. Format.cash(amount), GOLD, 40, 5, 1.4)
end

-- Dropper build-in: parts drop into place, dust and sparks at the base ----------------
local function onDropperBuilt(model: Model)
	if not (typeof(model) == "Instance" and model:IsA("Model") and model.Parent) then
		return
	end
	local base = model:GetPivot().Position
	if not nearCamera(base) then
		return
	end
	local parts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	table.sort(parts, function(a, b)
		return a.Position.Y < b.Position.Y
	end)
	for i, p in ipairs(parts) do
		local final = p.CFrame
		local finalT = p.Transparency
		p.CFrame = final + Vector3.new(0, 9, 0)
		p.Transparency = 1
		task.delay((i - 1) * 0.045, function()
			tween(p, 0.5, { CFrame = final }, Enum.EasingStyle.Back)
			tween(p, 0.25, { Transparency = finalT }, Enum.EasingStyle.Quad)
		end)
	end
	local footing = model:FindFirstChild("Footing")
	local ground = if footing and footing:IsA("BasePart") then footing.Position else base
	task.delay(0.42, function()
		local h = holder(CFrame.new(ground + Vector3.new(0, 0.3, 0)), Vector3.new(4, 0.2, 4), 2.5)
		emitter(h, {
			Texture = TEX.Smoke,
			LightEmission = 0,
			LightInfluence = 1,
			Color = ColorSequence.new(Color3.fromRGB(240, 238, 232)),
			Size = seq({ { 0, 1.5 }, { 1, 4.5 } }),
			Transparency = seq({ { 0, 0.45 }, { 1, 1 } }),
			Lifetime = NumberRange.new(0.6, 1.0),
			Speed = NumberRange.new(6, 10),
			SpreadAngle = Vector2.new(80, 80),
			EmissionDirection = Enum.NormalId.Top,
			Drag = 4,
			Rotation = NumberRange.new(0, 360),
			Shape = Enum.ParticleEmitterShape.Box,
		}):Emit(14)
		emitter(h, {
			Color = ColorSequence.new(TEAL, Color3.fromRGB(220, 255, 245)),
			Size = seq({ { 0, 0.7 }, { 1, 0 } }),
			Lifetime = NumberRange.new(0.6, 1.1),
			Speed = NumberRange.new(10, 22),
			SpreadAngle = Vector2.new(60, 60),
			EmissionDirection = Enum.NormalId.Top,
			Acceleration = Vector3.new(0, -30, 0),
			Drag = 2,
		}):Emit(26)
		ring(ground + Vector3.new(0, 0.3, 0), TEAL, 2, 14, 0.55)
	end)
end

-- Rebirth ----------------------------------------------------------------------------
-- Build-up (energy pulled into the plot, droppers glow, slight zoom) then on the
-- server's reset: tinted flash, shockwaves, a column of light and a shower of sparks.
-- Camera and lighting changes are made only for the owner and put back by ONE cleanup.
local flash = Instance.new("ColorCorrectionEffect")
flash.Name = "TycoonKitRebirthFlash"
flash.Enabled = true
flash.Brightness = 0
flash.Contrast = 0
flash.TintColor = Color3.new(1, 1, 1)
flash.Parent = Lighting

local fxGui = Instance.new("ScreenGui")
fxGui.Name = "TycoonKitFx"
fxGui.IgnoreGuiInset = true
fxGui.ResetOnSpawn = false
fxGui.DisplayOrder = 5
fxGui.Parent = player:WaitForChild("PlayerGui")

local rebirthCleanup: (() -> ())? = nil
local lastFrom = 1

local function onRebirthStart(plot: Model, from: number)
	lastFrom = from
	local center = plotCenter(plot)
	if not nearCamera(center) then
		return
	end
	local mine = isMine(plot)
	if mine and rebirthCleanup then
		rebirthCleanup()
	end
	local highlights = {}
	for _, m in ipairs(plot:GetChildren()) do
		if m:IsA("Model") and m.Name:match("^Dropper%d") then
			local hl = Instance.new("Highlight")
			hl.FillColor = PURPLE
			hl.OutlineColor = Color3.fromRGB(230, 200, 255)
			hl.FillTransparency = 1
			hl.OutlineTransparency = 1
			hl.DepthMode = Enum.HighlightDepthMode.Occluded
			hl.Parent = m
			tween(hl, 0.85, { FillTransparency = 0.35, OutlineTransparency = 0.1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			table.insert(highlights, hl)
		end
	end
	local ball = holder(CFrame.new(center + Vector3.new(0, 5, 0)), Vector3.new(56, 56, 56), 3)
	ball.Shape = Enum.PartType.Ball
	local pull = emitter(ball, {
		Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
		Color = ColorSequence.new(PURPLE, Color3.fromRGB(240, 220, 255)),
		Size = seq({ { 0, 0.9 }, { 0.7, 2.4 }, { 1, 0 } }),
		Transparency = seq({ { 0, 1 }, { 0.2, 0.05 }, { 1, 0.2 } }),
		Lifetime = NumberRange.new(0.8, 0.9),
		Speed = NumberRange.new(30, 34),
		Rate = 90, -- mobile caps an emitter near 100/s
		Orientation = Enum.ParticleOrientation.VelocityParallel,
	})
	local core = holder(CFrame.new(center + Vector3.new(0, 5, 0)), Vector3.one, 3)
	local glow = emitter(core, {
		Texture = TEX.Glow,
		Color = ColorSequence.new(PURPLE),
		Size = seq({ { 0, 2 }, { 1, 9 } }),
		Transparency = seq({ { 0, 0.7 }, { 1, 1 } }),
		Lifetime = NumberRange.new(0.5),
		Speed = NumberRange.new(0),
		Rate = 18,
	})
	local camera = workspace.CurrentCamera
	local fov0 = camera.FieldOfView
	if mine then
		tween(camera, 0.9, { FieldOfView = fov0 - 6 }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
	end

	local cleaned = false
	local function cleanup()
		if cleaned then
			return
		end
		cleaned = true
		pull.Enabled = false
		glow.Enabled = false
		for _, hl in ipairs(highlights) do
			hl:Destroy()
		end
		if mine then
			tween(camera, 0.6, { FieldOfView = fov0 }, Enum.EasingStyle.Quint)
			tween(flash, 0.5, { Brightness = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) }, Enum.EasingStyle.Quad)
			if rebirthCleanup == cleanup then
				rebirthCleanup = nil
			end
		end
	end
	if mine then
		rebirthCleanup = cleanup
	end
	task.delay(if mine then 4 else 1.2, cleanup) -- safety net if RebirthDone never arrives
end

local function bigTitle(title: string, sub: string)
	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.36)
	frame.Size = UDim2.fromScale(0.4, 0.17)
	frame.BackgroundTransparency = 1
	frame.Parent = fxGui
	local sc = Instance.new("UIScale")
	sc.Scale = 0.4
	sc.Parent = frame
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 0.62)
	t.Text = title
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Parent = frame
	local st = Instance.new("UIStroke")
	st.Color = PURPLE
	st.Thickness = 4
	st.Parent = t
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(225, 200, 255))
	g.Rotation = 90
	g.Parent = t
	local s = Instance.new("TextLabel")
	s.BackgroundTransparency = 1
	s.Position = UDim2.fromScale(0.15, 0.66)
	s.Size = UDim2.fromScale(0.7, 0.3)
	s.Text = sub
	s.TextScaled = true
	s.Font = Enum.Font.GothamBlack
	s.TextColor3 = GOLD
	s.Parent = frame
	local st2 = Instance.new("UIStroke")
	st2.Color = Color3.fromRGB(20, 14, 34)
	st2.Thickness = 3
	st2.Parent = s
	tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(1.7, function()
		tween(sc, 0.4, { Scale = 1.15 }, Enum.EasingStyle.Quad)
		tween(t, 0.4, { TextTransparency = 1 })
		tween(s, 0.4, { TextTransparency = 1 })
		tween(st, 0.4, { Transparency = 1 })
		tween(st2, 0.4, { Transparency = 1 })
		task.wait(0.45)
		frame:Destroy()
	end)
end

local function onRebirthDone(plot: Model, mult: number)
	local c = plotCenter(plot)
	if not nearCamera(c) then
		return
	end
	local mine = isMine(plot)
	if mine then
		flash.TintColor = Color3.fromRGB(240, 228, 255) -- a soft tint, never a white flash
		flash.Brightness = 0.16
		flash.Contrast = 0.04
		if rebirthCleanup then
			rebirthCleanup()
		end
	end
	ring(c + Vector3.new(0, 0.2, 0), PURPLE, 6, 96, 0.9)
	task.delay(0.08, function()
		ring(c + Vector3.new(0, 0.3, 0), Color3.fromRGB(255, 235, 255), 4, 70, 0.7)
	end)
	local col = Instance.new("Part")
	col.Shape = Enum.PartType.Cylinder
	col.Material = Enum.Material.Neon
	col.Color = Color3.fromRGB(205, 160, 255)
	col.Anchored = true
	col.CanCollide = false
	col.CanQuery = false
	col.CanTouch = false
	col.CastShadow = false
	col.Size = Vector3.new(60, 7, 7)
	col.CFrame = CFrame.new(c + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	col.Transparency = 0.25
	col.Parent = fxFolder
	tween(col, 0.7, { Size = Vector3.new(60, 0.5, 0.5), Transparency = 1 }, Enum.EasingStyle.Quart)
	task.delay(0.75, function()
		col:Destroy()
	end)
	local h = holder(CFrame.new(c + Vector3.new(0, 2, 0)), Vector3.new(2, 2, 2), 4)
	emitter(h, {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 200)),
			ColorSequenceKeypoint.new(0.4, GOLD),
			ColorSequenceKeypoint.new(1, PURPLE),
		}),
		Size = seq({ { 0, 1.4 }, { 0.5, 1 }, { 1, 0 } }),
		Transparency = seq({ { 0, 0 }, { 0.7, 0.1 }, { 1, 1 } }),
		Lifetime = NumberRange.new(1.2, 2.0),
		Speed = NumberRange.new(35, 70),
		SpreadAngle = Vector2.new(70, 70),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -35, 0),
		Drag = 2.2,
		RotSpeed = NumberRange.new(-180, 180),
	}):Emit(if mine then 90 else 40)
	if mine then
		local size = plot:GetExtentsSize()
		local sky = holder(CFrame.new(c + Vector3.new(0, 26, 0)), Vector3.new(math.min(size.X, 80), 1, math.min(size.Z, 80)), 4.5)
		local shower = emitter(sky, {
			Shape = Enum.ParticleEmitterShape.Box,
			Color = ColorSequence.new(GOLD, Color3.fromRGB(255, 250, 230)),
			Size = seq({ { 0, 0 }, { 0.15, 0.6 }, { 1, 0 } }),
			Lifetime = NumberRange.new(1.6, 2.2),
			Speed = NumberRange.new(6, 10),
			EmissionDirection = Enum.NormalId.Bottom,
			Acceleration = Vector3.new(0, -6, 0),
			Rate = 70,
		})
		task.delay(1.4, function()
			shower.Enabled = false
		end)
		bigTitle("REBIRTH!", "CASH " .. Format.mult(lastFrom) .. "  >>  " .. Format.mult(mult))
	end
end

Fx.OnClientEvent:Connect(function(kind, plot, a, b)
	if kind == "BankClaimed" and isPlot(plot) then
		onBankClaimed(plot, a)
	elseif kind == "DropperBuilt" and isPlot(plot) then
		onDropperBuilt(a)
	elseif kind == "RebirthStart" and isPlot(plot) then
		onRebirthStart(plot, a)
	elseif kind == "RebirthDone" and isPlot(plot) then
		onRebirthDone(plot, b)
	end
end)

FxFast.OnClientEvent:Connect(function(kind, plot, value, pos, golden)
	if kind == "Collect" and isPlot(plot) and typeof(pos) == "Vector3" then
		onCollect(plot, value, pos, golden == true)
	end
end)

-- Golden drops (from a pass with GoldenDrops) get a small sparkle so the boost shows.
local function onGoldenDrop(part: Instance)
	if part:IsA("BasePart") and not part:FindFirstChild("GoldSparkle") then
		local e = emitter(part, {
			Color = ColorSequence.new(Color3.fromRGB(255, 236, 170)),
			Size = seq({ { 0, 0.5 }, { 1, 0 } }),
			Lifetime = NumberRange.new(0.4, 0.6),
			Speed = NumberRange.new(1, 2),
			SpreadAngle = Vector2.new(180, 180),
			Rate = 5,
		})
		e.Name = "GoldSparkle"
	end
end
CollectionService:GetInstanceAddedSignal("TycoonGoldenDrop"):Connect(onGoldenDrop)
for _, part in ipairs(CollectionService:GetTagged("TycoonGoldenDrop")) do
	onGoldenDrop(part)
end
